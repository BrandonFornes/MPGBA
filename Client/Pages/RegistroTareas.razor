@page "/registrar_tarea"

@using MudBlazor
@using System.Text.RegularExpressions

<PageTitle>Registro Tareas</PageTitle>

<MudGrid Class="mt-5" Justify="Justify.Center">
    <MudItem xs="10" sm="7">
        <MudPaper Class="pa-4">

            <MudText Typo="Typo.h5" Class="mb-4">
                Registrar Tarea
            </MudText>

            <MudForm @ref="form" @bind-IsValid="success" @bind-Errors="errors">

                <MudTextField T="string"
                              Label="Tarea"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Campo obligatorio"
                              @bind-Value="nombreTarea"
                              Class="mb-4" />

                <MudTextField T="string"
                              Label="Comisión"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Campo obligatorio"
                              @bind-Value="comision"
                              Immediate="true"
                              Validation="ValidarComision"
                              Class="mb-4" />

                <MudCardActions>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               DisableElevation="true"
                               Class="ml-auto"
                               OnClick="RegistrarTarea">
                        Registrar Tarea
                    </MudButton>
                </MudCardActions>

            </MudForm>

        </MudPaper>
    </MudItem>
</MudGrid>

@code {

    bool success;
    string[] errors = { };
    MudForm form;

    string nombreTarea;
    string comision;

    void RegistrarTarea()
    {
        form.Validate();
        if (form.IsValid)
        {
            form.Reset();
            nombreTarea = null;
            comision = null;
        }
    }

    private string ValidarComision(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "Campo obligatorio";

        // Only numbers with exactly two decimals
        var regex = new Regex(@"^\d+(\.\d{2})$");

        if (!regex.IsMatch(value))
            return "Debe ser un número con exactamente 2 decimales (ej. 100.00)";

        return null;
    }
}
