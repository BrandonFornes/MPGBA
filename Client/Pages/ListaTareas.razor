@page "/tareas"

@using MudBlazor
@using System.Globalization
@inject NavigationManager NavigationManager

<PageTitle>Lista Tareas</PageTitle>

<MudGrid Class="mt-5" Justify="Justify.Center">
<MudItem xs="10">

        <MudText Typo="Typo.h3" Class="mb-4">
            Tareas
        </MudText>

        <MudPaper Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       Color="Color.Tertiary"
                       Class="mr-3"
                       @onclick="NavegarARegistrarTarea">
                Registrar Tarea
            </MudButton>
        </MudPaper>

<MudDataGrid T="Tarea"
             Items="@tareas"
             Filterable="true"
             Sortable="true"
             QuickFilter="@_quickFilter">

    <ToolBarContent>
        <MudText Typo="Typo.h6">Lista de Tareas</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_searchString"
                      Placeholder="Buscar tarea..."
                      Adornment="Adornment.Start"
                      Immediate="true"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"
                      Class="mt-0" />
    </ToolBarContent>

    <Columns>
        <PropertyColumn Property="x => x.Id" Title="ID" Sortable="true" />
        <PropertyColumn Property="x => x.TareaTxt" Title="Tarea" />

        <TemplateColumn Title="Comisión">
            <CellTemplate>
                @context.Item.Comision.ToString("C", new CultureInfo("es-MX"))
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager T="Tarea" />
    </PagerContent>

</MudDataGrid>

<MudCardActions>
    <MudButton Variant="Variant.Filled"
               Color="Color.Secondary"
               Class="ml-auto"
               DisableElevation="true"
               @onclick="NavegarAEliminarLavado">
        Eliminar Tarea
    </MudButton>
</MudCardActions>

</MudItem>
</MudGrid>

@code {

    private string _searchString;

    private List<Tarea> tareas = new()
    {
        new Tarea { Id = 1, TareaTxt = "Lavado Completo", Comision = 70 },
        new Tarea { Id = 2, TareaTxt = "Lavado Exterior", Comision = 40 },
        new Tarea { Id = 3, TareaTxt = "Lavado Interior", Comision = 35 }
    };

    private bool _quickFilter(Tarea x)
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.TareaTxt?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;

        if (x.Comision.ToString().Contains(_searchString))
            return true;

        return false;
    }

    class Tarea
    {
        public int Id { get; set; }
        public string TareaTxt { get; set; }
        public double Comision { get; set; }
    }

    private void NavegarARegistrarTarea()
    {
        NavigationManager.NavigateTo("/registrar_tarea");
    }

    private void NavegarAEliminarLavado()
    {
        NavigationManager.NavigateTo("/eliminar_tarea");
    }
}
