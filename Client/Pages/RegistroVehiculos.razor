@page "/registro_vehiculos"
@using System.Globalization

<MudGrid Class="mt-5" Justify="Justify.Center">
    <MudItem xs="12" sm="7">
        <MudPaper Class="pa-4">

            <MudText Typo="Typo.h5" Class="mb-4">Registrar Nuevo Vehículo</MudText>

            <MudForm @ref="formulario">

                <MudTextField T="string"
                              Label="Número de Serie"
                              Placeholder="Ingrese el No. de Serie"
                              @bind-Value="noSerie"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Campo Obligatorio"
                              Class="mb-4" />

                <MudSelect T="string"
                           Label="Modelo"
                           HelperText="Seleccione Marca y Modelo"
                           @bind-Value="modeloSeleccionado"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter"
                           Required="true"
                           RequiredError="Campo Obligatorio"
                           Class="mb-4">
                    @foreach (var modelo in listaModelos)
                    {
                        <MudSelectItem Value="@modelo">@modelo</MudSelectItem>
                    }
                </MudSelect>

                <MudNumericField T="int"
                                 Label="Año"
                                 @bind-Value="anioVehiculo"
                                 Variant="Variant.Outlined"
                                 Min="1900" Max="2100"
                                 Required="true"
                                 RequiredError="Campo Obligatorio"
                                 Class="mb-4" />

                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="Fecha de Llegada"
                                       @bind-Date="fechaLlegada"
                                       Variant="Variant.Outlined"
                                       Required="true"
                                       RequiredError="Campo Obligatorio"
                                       Class="mb-4" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="Último Mantenimiento"
                                       @bind-Date="fechaUltimoMantenimiento"
                                       Variant="Variant.Outlined"
                                       Class="mb-4" />
                    </MudItem>
                </MudGrid>

                <MudSelect T="string"
                           Label="Concesionario"
                           HelperText="Ubicación actual del vehículo"
                           @bind-Value="concesionarioSeleccionado"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter"
                           Required="true"
                           RequiredError="Campo Obligatorio"
                           Class="mb-4">
                    @foreach (var agencia in listaConcesionarios)
                    {
                        <MudSelectItem Value="@agencia">@agencia</MudSelectItem>
                    }
                </MudSelect>

                <MudCardActions>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Class="ml-auto"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="GuardarVehiculo">
                        Registrar Vehículo
                    </MudButton>
                </MudCardActions>

            </MudForm>
        </MudPaper>

        @if (mostrarExito)
        {
            <MudAlert Severity="Severity.Success" Class="mt-4" ShowCloseIcon="true" CloseIconClicked="(() => mostrarExito = false)">
                Registro exitoso: <strong>@modeloGuardado</strong> (Serie: @serieGuardada) asignado a @concesionarioGuardado.
            </MudAlert>
        }

    </MudItem>
</MudGrid>

@code {
    MudForm formulario;

    string noSerie = "";
    string modeloSeleccionado;
    int anioVehiculo = 2024;
    DateTime? fechaLlegada = DateTime.Today;
    DateTime? fechaUltimoMantenimiento = DateTime.Today;
    string concesionarioSeleccionado;
    bool mostrarExito = false;
    string serieGuardada = "";
    string modeloGuardado = "";
    string concesionarioGuardado = "";

    void GuardarVehiculo()
    {
        formulario.Validate();

        if (formulario.IsValid)
        {
            serieGuardada = noSerie;
            modeloGuardado = modeloSeleccionado;
            concesionarioGuardado = concesionarioSeleccionado;
            mostrarExito = true;

            noSerie = "";
            modeloSeleccionado = null;
            concesionarioSeleccionado = null;
            anioVehiculo = 2024;
            fechaLlegada = DateTime.Today;
            fechaUltimoMantenimiento = DateTime.Today;
            formulario.ResetValidation();
        }
    }


    List<string> listaModelos = new List<string>
    {
        "Ford Mustang",
        "Lincoln Navigator",
        "Mazda Mazda 3",
        "Dongfeng T5 Evo",
        "Jetour Dashing",
        "Soueast DX3",
        "Dodge Challenger",
        "Fiat 500",
        "Jeep Wrangler", "Jeep Grand Cherokee", "Jeep Renegade",
        "Peugeot 208",
        "Ram 1500",
    };

    List<string> listaConcesionarios = new List<string>
    {
        "FORD CIUDAD OBREGON", "FORD NAVOJOA", "FORD GUAYMAS",
        "LINCOLN CULIACAN", "VOLVO CULIACAN",
        "DONGFENG OBREGON", "DONGFENG HERMOSILLO",
        "MAZDA CULIACAN", "MAZDA MAZATLAN",
        "PEUGEOT CULIACAN", "PEUGEOT CIUDAD OBREGON",
        "RAM HERMOSILLO",
        "FIAT CIUDAD OBREGON", 
        "DODGE CIUDAD OBREGON", 
        "JEEP CIUDAD OBREGON",
        "JIM OBREGON", "JIM CULIACAN",
        "JETOUR OBREGON", "JETOUR MAZATLAN"
    };
}