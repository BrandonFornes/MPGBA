@page "/mantenimientos/mantenimiento/registro_mantenimientos"
@using MudBlazor

<MudGrid Class="mt-5" Justify="Justify.Center">
    <MudItem xs="12" sm="7">
        <MudPaper Class="pa-4">

            <MudText Typo="Typo.h5" Class="mb-4">
                Registrar Mantenimiento
            </MudText>

            <MudForm @ref="formulario" Spacing="6">

                <MudSelect T="string"
                           Label="Selecciona Vehículo"
                           @bind-Value="vehiculoSeleccionado"
                           Variant="Variant.Outlined"
                           Required="true"
                           RequiredError="Campo Obligatorio"
                           Searchable="true"
                           AnchorOrigin="Origin.BottomCenter"
                           Class="mb-4">

                    @foreach (var vehiculo in _vehiculos)
                    {
                        <MudSelectItem Value="@vehiculo">
                            @vehiculo
                        </MudSelectItem>
                    }

                </MudSelect>

                <MudCardActions>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Class="ml-auto"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="GuardarMantenimiento">
                        Registrar Mantenimiento
                    </MudButton>
                </MudCardActions>

            </MudForm>
        </MudPaper>

        @if (mostrarExito)
        {
            <MudAlert Severity="Severity.Success"
                      Class="mt-4"
                      ShowCloseIcon="true"
                      CloseIconClicked="(() => mostrarExito = false)">
                Mantenimiento registrado para:
                <strong>@vehiculoSeleccionado</strong>
            </MudAlert>
        }

    </MudItem>
</MudGrid>

@code {

    MudForm formulario;
    bool mostrarExito = false;

    string vehiculoSeleccionado;

    void GuardarMantenimiento()
    {
        formulario.Validate();

        if (formulario.IsValid)
        {
            mostrarExito = true;
        }
    }

    private readonly string[] _vehiculos = new[]
    {
        "101 - FRD-2024-X - Ford Ranger Raptor - FORD CIUDAD OBREGON",
        "102 - MZD-5544-Y - Mazda CX-5 - MAZDA LOS MOCHIS",
        "103 - JEEP-WRG-4X4 - Jeep Wrangler Rubicon - JEEP CIUDAD OBREGON",
        "104 - PEU-2008-GT - Peugeot 2008 GT - PEUGEOT CIUDAD OBREGON",
        "105 - JEEP-WRG-4X4 - Jeep Wrangler Rubicon - JEEP CIUDAD OBREGON",
        "106 - RAM-700-LRAM - Ram 700 Laramie - RAM TRES RIOS",
        "107 - JET-X70-PLUS - Jetour X70 Plus - JETOUR MAZATLAN",
        "108 - LNC-NVG-BLK - Lincoln Navigator - LINCOLN CULIACAN",
        "109 - FIA-PLS-ABTH - Fiat Pulse Abarth - FIAT TRES RIOS",
        "110 - BST-B70-TURB - Bestune B70 - BESTUNE OBREGON",
        "111 - JIM-REMAX-42 - JIM Re-Max S - JIM HERMOSILLO",
        "112 - DGE-ATT-SXT - Dodge Attitude - DODGE CIUDAD OBREGON",
        "113 - VOL-XC60-HYB - Volvo XC60 Recharge - VOLVO CULIACAN"
    };
}
