@page "/mantenimientos/mantenimiento"
@using System.Globalization
@using AdminHerramientas.Shared.Models
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Historial de Mantenimientos</PageTitle>

<MudGrid Class="mt-5" Justify="Justify.Center">
    <MudItem xs="10">
        <MudText Typo="Typo.h3" Class="mb-4">Mantenimientos</MudText>

        <MudPaper Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled" Size="Size.Large" Color="Color.Tertiary" Class="mr-3"
                        OnClick="@AbrirCrearMantenimiento">
                Registrar Mantenimiento
            </MudButton>

            @* --- OVERLAY --- *@
            <MudOverlay Visible="_abreCrearMantenimiento" OnClick="@AbrirCrearMantenimiento" DarkBackground="true" ZIndex="5" />
            <MudOverlay Visible="_verHistorialDetalle" OnClick="@(() => _verHistorialDetalle = false)" DarkBackground="true" ZIndex="5" />

            @* --- POPOVER: REGISTRAR --- *@
            <MudPopover Open="@_abreCrearMantenimiento" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" RelativePanel="true">
                <MudText Typo="Typo.h5" Class="pa-4">@(selectedItem == null ? "Registrar" : "Editar")</MudText>
                <div style="width: 700px;" class="pa-5">
                    <MudForm @ref="formulario">
                        <MudGrid>
                            <MudItem xs="12">
                                <MudAutocomplete T="Vehiculo" 
                                    Label="Vehículo" 
                                    @bind-Value="vehiculoSeleccionado" 
                                    SearchFunc="@SearchVehiculos"
                                    ToStringFunc="@(v => v == null ? null : $"{v.Bastidor} - {v.DesMarca} {v.DesModelo}")"
                                    Variant="Variant.Outlined" 
                                    Required="true" 
                                    Class="mb-4"
                                    ResetValueOnEmptyText="true"
                                    CoerceText="false" 
                                    CoerceValue="false" />
                            </MudItem>
                            <MudItem xs="6">
                                
                                <MudAutocomplete T="Concesionario" 
                                    Label="Agencia" 
                                    @bind-Value="concesionarioSeleccionado" 
                                    SearchFunc="@SearchConcesionario"
                                    ToStringFunc="@(c => c == null ? null : $"{c.Nombre}")"
                                    Variant="Variant.Outlined" 
                                    Required="true" 
                                    Class="mb-4"
                                    ResetValueOnEmptyText="true"
                                    CoerceText="false" 
                                    CoerceValue="false" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudDatePicker Label="Fecha" @bind-Date="fechaSeleccionada" Variant="Variant.Outlined" Required="true" />
                            </MudItem>
                        </MudGrid>
                        <MudCardActions>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" OnClick="GuardarMantenimiento" Disabled="@_procesando" >
                                @( _procesando ? "Procesando..." : "Guardar" )
                            </MudButton>
                        </MudCardActions>
                    </MudForm>
                </div>
            </MudPopover>

            @* --- POPOVER: HISTORIAL DETALLADO --- *@
            <MudPopover Open="@_verHistorialDetalle" 
                        AnchorOrigin="Origin.BottomCenter" 
                        TransformOrigin="Origin.TopCenter" 
                        Fixed="true" 
                        Style="width:800px; max-height: 400px; overflow-y: auto; overflow-x: hidden;">
                
                <MudPaper Elevation="0" Class="pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Info" />
                        <MudText Typo="Typo.h5">Historial: @bastidorSeleccionadoDetalle</MudText>
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" 
                                    Color="Color.Error" 
                                    OnClick="@(() => _verHistorialDetalle = false)" />
                    </MudStack>

                    <MudDivider Class="mb-4" />

                    <div style="max-height: 300px; overflow-y: auto;">
                        <MudTable Items="@historialFiltrado" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Fecha</MudTh>
                                <MudTh>Agencia / Concesionario</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.fechaMantenimiento.ToString("dd/MM/yyyy")</MudTd>
                                <MudTd>@ObtenerNombreConcesionario(context.IdConcesionario)</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                    
                    
                </MudPaper>
            </MudPopover>
        </MudPaper>

        <MudDataGrid T="MantenimientoView" Items="@listaProcesadaGrid" Filterable="true" Sortable="true" QuickFilter="@_quickFilter">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Panel de Control</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString" Placeholder="Buscar..." 
                        Adornment="Adornment.Start" Immediate="true"
                        AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.Original.Id" Title="Folio" Sortable="false" Filterable="false" />
                <PropertyColumn Property="x => x.Original.FkBastidor" Title="Bastidor" Sortable="false" Filterable="false" />
                <PropertyColumn Property="x => x.InfoVehiculo" Title="Vehículo" />
                <PropertyColumn Property="x => x.Original.fechaMantenimiento" Title="Último Servicio" Format="dd/MM/yyyy" Sortable="false" Filterable="false" />
                <PropertyColumn Property="x => x.FechaSiguiente"
                                Title="Próximo Servicio"
                                Format="dd/MM/yyyy" />
                            
                <TemplateColumn Title="Estado">
                    <CellTemplate>
                        <MudChip Color="@context.Item.ColorEstado"
                                 Variant="Variant.Filled"
                                 Size="Size.Small">
                            @context.Item.EstadoDesc
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Acciones" Sortable="false" Filterable="false">
                    <CellTemplate>
                        <MudStack Row="true">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small" OnClick="@(() => EditarRegistro(context.Item.Original))" />
                            <MudIconButton Icon="@Icons.Material.Filled.History" Color="Color.Info" Size="Size.Small" OnClick="@(() => VerHistorialCompleto(context.Item.Original.FkBastidor))" />
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="MantenimientoView" 
                        RowsPerPageString="Filas por página:" 
                        InfoFormat="{first_item}-{last_item} de {all_items}" 
                        AllItemsText="Todos" />
            </PagerContent>
        </MudDataGrid>
    </MudItem>
</MudGrid>

@code {
    private string _searchString = "";
    MudForm formulario;
    private List<HistorialMantenimiento> listaHistorial = new();
    private List<Vehiculo> listaVehiculos = new();
    private List<Concesionario> listaConcesionarios = new();

    private Dictionary<string, Vehiculo> _dictVehiculos = new();
    private Dictionary<int, Concesionario> _dictConcesionarios = new();
    private Dictionary<string, int> _dictIntervalosPorMarca = new();


    private HistorialMantenimiento? selectedItem;
    private Vehiculo? vehiculoSeleccionado;
    private Concesionario? concesionarioSeleccionado;
    private DateTime? fechaSeleccionada = DateTime.Today;

    private List<Intervalo> listaIntervalos = new();
    private int intervaloDefault = 180;

    public class MantenimientoView
    {
        public HistorialMantenimiento Original { get; set; }
        public string InfoVehiculo { get; set; }
        public DateTime FechaSiguiente { get; set; }
        public string EstadoDesc { get; set; }
        public Color ColorEstado { get; set; }
    }

    private List<MantenimientoView> listaProcesadaGrid = new();

    private bool _abreCrearMantenimiento;
    private bool _verHistorialDetalle;
    private string bastidorSeleccionadoDetalle = "";

    private bool _procesando = false;

    private List<HistorialMantenimiento> historialFiltrado = new();

    protected override async Task OnInitializedAsync() => await CargarDatos();

    private async Task CargarDatos() 
    {

        try 
        {
            var t1 = Http.GetFromJsonAsync<List<HistorialMantenimiento>>("api/historialmantenimientos");
            var t2 = Http.GetFromJsonAsync<List<Vehiculo>>("api/vehiculos");
            var t3 = Http.GetFromJsonAsync<List<Concesionario>>("api/concesionarios");
            var t4 = Http.GetFromJsonAsync<List<Intervalo>>("api/intervalos");

            await Task.WhenAll(t1, t2, t3, t4);
            listaHistorial = await t1 ?? new();
            listaVehiculos = await t2 ?? new();
            listaConcesionarios = await t3 ?? new();
            listaIntervalos = await t4 ?? new();

            _dictVehiculos = listaVehiculos.ToDictionary(v => v.Bastidor, v => v);
            _dictConcesionarios = listaConcesionarios.ToDictionary(c => c.Id, c => c);
            _dictIntervalosPorMarca = listaIntervalos.ToDictionary(i => i.marcavehiculo, i => i.Intervalo_dias);

            ProcesarListaGrid();

        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al cargar datos: " + ex.Message, Severity.Error);
        }
    }
    private void ProcesarListaGrid()
    {
        var hoy = DateTime.Now;
        var limiteProximo = hoy.AddDays(15);

        listaProcesadaGrid = listaHistorial
            .GroupBy(x => x.FkBastidor)
            .Select(g =>
            {
                var ultimo = g.OrderByDescending(m => m.fechaMantenimiento).First();
                var vehiculo = _dictVehiculos.GetValueOrDefault(ultimo.FkBastidor);

                // Calcular días de intervalo
                int dias = 180; // Default
                if (vehiculo != null) dias = _dictIntervalosPorMarca.GetValueOrDefault(vehiculo.Marca, 180);

                var fechaSiguiente = ultimo.fechaMantenimiento.AddDays(dias);

                // Determinar estado
                string estado = "EN TIEMPO";
                Color colorEstado = Color.Success;
                if (fechaSiguiente < hoy) { estado = "VENCIDO"; colorEstado = Color.Error; }
                else if (fechaSiguiente <= limiteProximo) { estado = "PRÓXIMO"; colorEstado = Color.Warning; }

                return new MantenimientoView
                {
                    Original = ultimo,
                    InfoVehiculo = vehiculo != null ? $"{vehiculo.DesMarca} {vehiculo.DesModelo}" : ultimo.FkBastidor,
                    FechaSiguiente = fechaSiguiente,
                    EstadoDesc = estado,
                    ColorEstado = colorEstado
                };
            }).ToList();
    }

    private void VerHistorialCompleto(string bastidor) 
    {
        bastidorSeleccionadoDetalle = bastidor;
        historialFiltrado = listaHistorial.Where(x => x.FkBastidor == bastidor).OrderByDescending(x => x.fechaMantenimiento).ToList();
        _verHistorialDetalle = true;
    }

    private async Task GuardarMantenimiento() 
    {
        if (_procesando) return;

        await formulario.Validate();
        if (formulario.IsValid) {
            _procesando = true;

            try
            {
                var registro = new HistorialMantenimiento {
                    Id = selectedItem?.Id ?? 0,
                    FkBastidor = vehiculoSeleccionado.Bastidor,
                    IdConcesionario = concesionarioSeleccionado.Id,
                    fechaMantenimiento = fechaSeleccionada ?? DateTime.Now,
                    FechaModificacion = DateTime.Now,
                    UsuarioModifico = 1,
                    Activo = true
                };
                var res = selectedItem == null ? await Http.PostAsJsonAsync("api/historialmantenimientos", registro) : await Http.PutAsJsonAsync($"api/historialmantenimientos/{registro.Id}", registro);
                if (res.IsSuccessStatusCode) {
                    await CargarDatos();
                    _abreCrearMantenimiento = false;
                    LimpiarForm();
                    Snackbar.Add("Guardado", Severity.Success);
                }
                else
                {
                    Snackbar.Add("Error al procesar la solicitud", Severity.Error);
                }
            }
            finally
            {
                _procesando = false;
            }
        }
    }

    private void EditarRegistro(HistorialMantenimiento item) {
        selectedItem = item;
        vehiculoSeleccionado = _dictVehiculos.TryGetValue(item.FkBastidor, out var vehiculo) ? vehiculo : null; 
        concesionarioSeleccionado = _dictConcesionarios.TryGetValue(item.IdConcesionario, out var concesionario) ? concesionario : null;    
        fechaSeleccionada = item.fechaMantenimiento;
        _abreCrearMantenimiento = true;
    }

    private void LimpiarForm() {
        selectedItem = null;
        vehiculoSeleccionado = null;
        concesionarioSeleccionado = null;
        fechaSeleccionada = DateTime.Today;
    }

    public void AbrirCrearMantenimiento() {
        if (!_abreCrearMantenimiento) LimpiarForm();
        _abreCrearMantenimiento = !_abreCrearMantenimiento;
    }

    private bool _quickFilter(MantenimientoView x)
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;

        return x.Original.FkBastidor.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
                x.InfoVehiculo.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
                x.Original.fechaMantenimiento.ToString("dd/MM/yyyy").Contains(_searchString) ||
                x.FechaSiguiente.ToString("dd/MM/yyyy").Contains(_searchString) ||
                x.EstadoDesc.Contains(_searchString, StringComparison.OrdinalIgnoreCase);
    }

    private async Task<IEnumerable<Vehiculo>> SearchVehiculos(string value)
    {
        if (string.IsNullOrEmpty(value))
            return listaVehiculos;

        return listaVehiculos.Where(x => 
            x.Bastidor.Contains(value, StringComparison.InvariantCultureIgnoreCase) ||
            x.Idv.ToString().Contains(value, StringComparison.InvariantCultureIgnoreCase) ||
            x.DesMarca.Contains(value, StringComparison.InvariantCultureIgnoreCase) ||
            x.DesModelo.Contains(value, StringComparison.InvariantCultureIgnoreCase)).Take(25);
    }

    private async Task<IEnumerable<Concesionario>> SearchConcesionario(string value)
    {
        if (string.IsNullOrEmpty(value))
            return listaConcesionarios;

        return listaConcesionarios.Where(x => x.Nombre.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }


    private string ObtenerNombreConcesionario(int id) => 
    _dictConcesionarios.TryGetValue(id, out var concesionario)? concesionario.Nombre : "Desconocido";
}