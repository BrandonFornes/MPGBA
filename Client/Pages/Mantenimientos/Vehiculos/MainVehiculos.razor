@page "/mantenimientos/vehiculos"
@using MudBlazor
@using AdminHerramientas.Shared.Models
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Gestión de Vehículos</PageTitle>

<MudGrid Class="mt-5" Justify="Justify.Center">
    <MudItem xs="10">
        <MudText Typo="Typo.h3" Class="mb-4">Vehículos</MudText>

        <MudPaper Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled" Size="Size.Large" Color="Color.Tertiary" OnClick="@AbrirCrearVehiculo">
                Registrar Vehículo
            </MudButton>

            <MudOverlay Visible="_abreCrearVehiculo" OnClick="@AbrirCrearVehiculo" DarkBackground="true" ZIndex="5" />

            <MudPopover Open="@_abreCrearVehiculo" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" RelativePanel="true">
                <MudText Typo="Typo.h5" Class="pa-4">@(selectedItem == null ? "Registrar Nuevo" : "Editar") Vehículo</MudText>
                
                <div style="width: 800px; height: auto;" class="pa-5">
                    <MudForm @ref="formulario">
                        <MudGrid>
                            <MudItem xs="6">
                                <MudTextField T="string" Label="IDV" @bind-Value="nuevoVehiculo.Idv" Required="true" Variant="Variant.Outlined" Class="mb-4" />
                                <MudTextField T="string" Label="Bastidor (VIN)" @bind-Value="nuevoVehiculo.Bastidor" Required="true" Variant="Variant.Outlined" Class="mb-4" Disabled="@(selectedItem != null)" />
                                <MudTextField T="string" Label="Marca" @bind-Value="nuevoVehiculo.Marca" Required="true" Variant="Variant.Outlined" MaxLength="5" Class="mb-4" />
                                <MudTextField T="string" Label="Descripción Marca" @bind-Value="nuevoVehiculo.DesMarca" Variant="Variant.Outlined" Class="mb-4" />
                                <MudTextField T="string" Label="Modelo" @bind-Value="nuevoVehiculo.Modelo" Variant="Variant.Outlined" Class="mb-4" />
                            </MudItem>
                            
                            <MudItem xs="6">
                                <MudTextField T="string" Label="Descripción Modelo" @bind-Value="nuevoVehiculo.DesModelo" Variant="Variant.Outlined" Class="mb-4" />
                                <MudTextField T="string" Label="Año" @bind-Value="nuevoVehiculo.AnioVehi" Variant="Variant.Outlined" Class="mb-4" />
                                <MudNumericField T="decimal?" Label="Kilometraje" @bind-Value="nuevoVehiculo.Km" Variant="Variant.Outlined" Class="mb-4" />
                                <MudTextField T="string" Label="Familia" @bind-Value="nuevoVehiculo.Familia" Variant="Variant.Outlined" Class="mb-4" />
                                <MudDatePicker Label="Fecha Fin" @bind-Date="fechaFinSeleccionada" Required="true" Variant="Variant.Outlined" />
                            </MudItem>
                        </MudGrid>

                        <MudCardActions>
                            <MudButton OnClick="@AbrirCrearVehiculo" Color="Color.Default" Class="mr-2">Cancelar</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" StartIcon="@Icons.Material.Filled.Save" OnClick="GuardarVehiculo" Disabled="@_procesando">
                                    @( _procesando ? "Procesando..." : (selectedItem == null ? "Guardar" : "Actualizar" ) )
                            </MudButton>
                        </MudCardActions>
                    </MudForm>
                </div>
            </MudPopover>
        </MudPaper>

        <MudDataGrid T="Vehiculo" Items="@ListaVehiculos" Filterable="true" Sortable="true" QuickFilter="@_quickFilter">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Listado de Vehículos</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString" Placeholder="Buscar..." Adornment="Adornment.Start" Immediate="true" AdornmentIcon="@Icons.Material.Filled.Search" />
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.Idv" Title="IDV" Sortable="false" Filterable="false" />
                <PropertyColumn Property="x => x.Bastidor" Title="Bastidor" Sortable="false" Filterable="false" />
                <PropertyColumn Property="x => x.Marca" Title="Marca" Sortable="false" Filterable="false" />
                <PropertyColumn Property="x => x.DesModelo" Title="Modelo" Sortable="false" Filterable="false" />
                <PropertyColumn Property="x => x.AnioVehi" Title="Año" Sortable="false" Filterable="false" />
                <PropertyColumn Property="x => x.Km" Title="Kms" Format="N0" Sortable="false" Filterable="false" />
                <PropertyColumn Property="x => x.Fechafin" Title="Fecha Fin" Format="dd/MM/yyyy" Sortable="false" Filterable="false" />
                
                <TemplateColumn Title="Acciones" Filterable="false" Sortable="false">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small" OnClick="@(() => EditarVehiculo(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="Vehiculo" 
                        RowsPerPageString="Filas por página:" 
                        InfoFormat="{first_item}-{last_item} de {all_items}" 
                        AllItemsText="Todos" />
            </PagerContent>
        </MudDataGrid>
    </MudItem>
</MudGrid>

@code {
    private string _searchString;
    private List<Vehiculo> ListaVehiculos = new();
    private Vehiculo nuevoVehiculo = new();
    private Vehiculo? selectedItem; 
    private MudForm formulario;
    private DateTime? fechaFinSeleccionada = DateTime.Today.AddYears(1);
    public bool _abreCrearVehiculo;

    private bool _procesando = false;

    protected override async Task OnInitializedAsync() => await CargarVehiculos();

    private async Task CargarVehiculos() {
        try {
            ListaVehiculos = await Http.GetFromJsonAsync<List<Vehiculo>>("api/vehiculos") ?? new();
        } catch (Exception ex) {
            Snackbar.Add("Error al cargar datos: " + ex.Message, Severity.Error);
        }
    }

    private void EditarVehiculo(Vehiculo v) {
        selectedItem = v;
        nuevoVehiculo = new Vehiculo {
            Idv = v.Idv,
            Bastidor = v.Bastidor,
            Marca = v.Marca,
            DesMarca = v.DesMarca,
            Modelo = v.Modelo,
            DesModelo = v.DesModelo,
            AnioVehi = v.AnioVehi,
            Km = v.Km,
            Familia = v.Familia,
            Fechafin = v.Fechafin
        };
        fechaFinSeleccionada = v.Fechafin;
        _abreCrearVehiculo = true;
    }

    private async Task GuardarVehiculo() {
        if (_procesando) return;

        await formulario.Validate();
        if (formulario.IsValid) {
            _procesando = true;

            try
            {
                nuevoVehiculo.Fechafin = fechaFinSeleccionada ?? DateTime.Now;
                
                HttpResponseMessage response;
                
                if (selectedItem == null) {
                    response = await Http.PostAsJsonAsync("api/vehiculos", nuevoVehiculo);
                } else {
                    response = await Http.PutAsJsonAsync($"api/vehiculos/{nuevoVehiculo.Bastidor}", nuevoVehiculo);
                }
                
                if (response.IsSuccessStatusCode) {
                    Snackbar.Add(selectedItem == null ? "Vehículo registrado" : "Vehículo actualizado", Severity.Success);
                    await CargarVehiculos();
                    _abreCrearVehiculo = false;
                    LimpiarFormulario();
                } else {
                    Snackbar.Add("Error al procesar la solicitud", Severity.Error);
                }

            }
            finally
            {
                _procesando = false;
            }
        }
    }

    private void LimpiarFormulario() {
        selectedItem = null;
        nuevoVehiculo = new Vehiculo();
        fechaFinSeleccionada = DateTime.Today.AddYears(1);
        if (formulario != null) formulario.ResetValidation();
    }

    public void AbrirCrearVehiculo() {
        if (!_abreCrearVehiculo) LimpiarFormulario();
        _abreCrearVehiculo = !_abreCrearVehiculo;
    }

    private bool _quickFilter(Vehiculo x) {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        return (x.Bastidor?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) || 
                (x.Marca?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.DesMarca?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Modelo?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.DesModelo?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.DesColor?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.DesFamilia?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.AnioVehi?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Idv?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false);
    }

}