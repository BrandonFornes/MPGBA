@page "/mantenimientos/vehiculos"
@using MudBlazor
@using AdminHerramientas.Shared.Models
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Gestión de Vehículos</PageTitle>

<MudGrid Class="mt-5" Justify="Justify.Center">
    <MudItem xs="10">
        <MudText Typo="Typo.h3" Class="mb-4">Vehículos</MudText>

        <MudPaper Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled" Size="Size.Large" Color="Color.Tertiary" OnClick="@AbrirCrearVehiculo">
                Registrar Vehículo
            </MudButton>

            @* --- OVERLAY Y POPOVER --- *@
            <MudOverlay Visible="_abreCrearVehiculo" OnClick="@AbrirCrearVehiculo" DarkBackground="true" ZIndex="5" />

            <MudPopover Open="@_abreCrearVehiculo" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" RelativePanel="true">
                <MudText Typo="Typo.h5" Class="pa-4">Registrar Nuevo Vehículo</MudText>
                
                <div style="width: 800px; height: auto;" class="pa-5">
                    <MudForm @ref="formulario">
                        <MudGrid>
                            <MudItem xs="6">
                                <MudTextField T="string" Label="IDV" @bind-Value="nuevoVehiculo.Idv" Required="true" Variant="Variant.Outlined" Class="mb-4" />
                                <MudTextField T="string" Label="Bastidor (VIN)" @bind-Value="nuevoVehiculo.Bastidor" Required="true" Variant="Variant.Outlined" Class="mb-4" />
                                <MudTextField T="string" Label="Marca" @bind-Value="nuevoVehiculo.Marca" Required="true" Variant="Variant.Outlined" MaxLength="5" Class="mb-4" />
                                <MudTextField T="string" Label="Descripción Marca" @bind-Value="nuevoVehiculo.DesMarca" Variant="Variant.Outlined" Class="mb-4" />
                                <MudTextField T="string" Label="Modelo" @bind-Value="nuevoVehiculo.Modelo" Variant="Variant.Outlined" Class="mb-4" />
                            </MudItem>
                            
                            <MudItem xs="6">
                                <MudTextField T="string" Label="Descripción Modelo" @bind-Value="nuevoVehiculo.DesModelo" Variant="Variant.Outlined" Class="mb-4" />
                                <MudTextField T="string" Label="Año" @bind-Value="nuevoVehiculo.AnioVehi" Variant="Variant.Outlined" Class="mb-4" />
                                <MudNumericField T="decimal?" Label="Kilometraje" @bind-Value="nuevoVehiculo.Km" Variant="Variant.Outlined" Class="mb-4" />
                                <MudSelect T="string" Label="Familia" @bind-Value="nuevoVehiculo.Familia" Variant="Variant.Outlined" Class="mb-4">
                                    @foreach (var f in listaFamilias) { <MudSelectItem Value="@f">@f</MudSelectItem> }
                                </MudSelect>
                                <MudDatePicker Label="Fecha Fin" @bind-Date="fechaFinSeleccionada" Required="true" Variant="Variant.Outlined" />
                            </MudItem>
                        </MudGrid>

                        <MudCardActions>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" StartIcon="@Icons.Material.Filled.Save" OnClick="GuardarVehiculo">
                                Guardar Vehículo
                            </MudButton>
                        </MudCardActions>
                    </MudForm>
                </div>
            </MudPopover>
        </MudPaper>

        <MudDataGrid T="Vehiculo" Items="@ListaVehiculos" Filterable="true" Sortable="true" QuickFilter="@_quickFilter">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Listado Real de Vehículos</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString" Placeholder="Buscar..." Adornment="Adornment.Start" Immediate="true" AdornmentIcon="@Icons.Material.Filled.Search" />
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.Idv" Title="IDV" />
                <PropertyColumn Property="x => x.Bastidor" Title="Bastidor" />
                <PropertyColumn Property="x => x.DesMarca" Title="Marca" />
                <PropertyColumn Property="x => x.DesModelo" Title="Modelo" />
                <PropertyColumn Property="x => x.AnioVehi" Title="Año" />
                <PropertyColumn Property="x => x.Km" Title="Kms" Format="N0" />
                <PropertyColumn Property="x => x.Fechafin" Title="Fecha Fin" Format="dd/MM/yyyy" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="Vehiculo" />
            </PagerContent>
        </MudDataGrid>
    </MudItem>
</MudGrid>

@code {
    private string _searchString;
    private List<Vehiculo> ListaVehiculos = new();
    private Vehiculo nuevoVehiculo = new();
    private MudForm formulario;
    private DateTime? fechaFinSeleccionada = DateTime.Today.AddYears(1);
    public bool _abreCrearVehiculo;

    protected override async Task OnInitializedAsync()
    {
        await CargarVehiculos();
    }

    private async Task CargarVehiculos()
    {
        try {
            ListaVehiculos = await Http.GetFromJsonAsync<List<Vehiculo>>("api/vehiculos") ?? new();
        } catch (Exception ex) {
            Snackbar.Add("Error al cargar vehículos: " + ex.Message, Severity.Error);
        }
    }

    private async Task GuardarVehiculo()
    {
        await formulario.Validate();
        if (formulario.IsValid)
        {
            nuevoVehiculo.Fechafin = fechaFinSeleccionada ?? DateTime.Now;
            
            var response = await Http.PostAsJsonAsync("api/vehiculos", nuevoVehiculo);
            
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Vehículo registrado exitosamente", Severity.Success);
                await CargarVehiculos();
                _abreCrearVehiculo = false;
                LimpiarFormulario();
            }
            else
            {
                Snackbar.Add("Error al guardar. Revisa que el IDV o Bastidor no estén duplicados.", Severity.Error);
            }
        }
    }

    private void LimpiarFormulario()
    {
        nuevoVehiculo = new Vehiculo();
        fechaFinSeleccionada = DateTime.Today.AddYears(1);
        formulario.ResetValidation();
    }

    public void AbrirCrearVehiculo()
    {
        if (_abreCrearVehiculo) LimpiarFormulario();
        _abreCrearVehiculo = !_abreCrearVehiculo;
    }

    private bool _quickFilter(Vehiculo x)
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        return x.Bastidor.Contains(_searchString, StringComparison.OrdinalIgnoreCase) || 
               x.DesMarca.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
               x.Idv.Contains(_searchString, StringComparison.OrdinalIgnoreCase);
    }

    List<string> listaFamilias = new() { "FORD", "MAZDA", "DONGFENG", "JETOUR", "LINCOLN" };
}