@page "/mantenimientos/vehiculos"
@using MudBlazor
@inject NavigationManager NavigationManager

<MudGrid Class="mt-5" Justify="Justify.Center">
<MudItem xs="10">

        <MudText Typo="Typo.h3" Class="mb-4">
            Vehículos
        </MudText>

        <MudPaper Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       Color="Color.Tertiary"
                       OnClick="@AbrirCrearVehiculo">
                Registrar Vehículo
            </MudButton>

            <MudOverlay Visible="_abreCrearVehiculo" OnClick="@AbrirCrearVehiculo" DarkBackground="true" ZIndex="5" />

            <MudPopover Open="@_abreCrearVehiculo" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" RelativePanel="true">
                
                <MudText Typo="Typo.h5" Class="pa-4">
                    Registrar Nuevo Vehículo
                </MudText>
                
                <div style="width: 1000px; heigth: auto;" class="pa-5">
                    <MudStack Spacing="4">
                        <MudForm @ref="formulario" Spacing="9">

                            <MudTextField T="string"
                                        Label="Bastidor"
                                        Placeholder="Ingrese el Bastidor"
                                        @bind-Value="noSerie"
                                        Variant="Variant.Outlined"
                                        Required="true"
                                        RequiredError="Campo Obligatorio"
                                        Class="mb-4" />

                            <MudSelect T="string"
                                    Label="Modelo"
                                    HelperText="Seleccione Marca y Modelo"
                                    @bind-Value="modeloSeleccionado"
                                    Variant="Variant.Outlined"
                                    AnchorOrigin="Origin.BottomCenter"
                                    Required="true"
                                    RequiredError="Campo Obligatorio"
                                    Class="mb-4">
                                @foreach (var modelo in listaModelos)
                                {
                                    <MudSelectItem Value="@modelo">@modelo</MudSelectItem>
                                }
                            </MudSelect>

                            <MudTextField T="string"
                                        Label="Color"
                                        Placeholder="Ingrese el Color"
                                        @bind-Value="color"
                                        Variant="Variant.Outlined"
                                        Required="true"
                                        RequiredError="Campo Obligatorio"
                                        Class="mb-4" />

                            <MudNumericField T="int"
                                            Label="Año"
                                            @bind-Value="anioVehiculo"
                                            Variant="Variant.Outlined"
                                            Min="1900" Max="2100"
                                            Required="true"
                                            RequiredError="Campo Obligatorio"
                                            Class="mb-4" />
                            
                            <MudNumericField T="int"
                                            Label="Kilometraje"
                                            @bind-Value="km"
                                            Variant="Variant.Outlined"
                                            Min="0"
                                            Required="true"
                                            RequiredError="Campo Obligatorio"
                                            Class="mb-4" />
                            

                            <MudSelect T="string"
                                    Label="Familia"
                                    HelperText="Ubicación actual del vehículo"
                                    @bind-Value="concesionarioSeleccionado"
                                    Variant="Variant.Outlined"
                                    AnchorOrigin="Origin.BottomCenter"
                                    Required="true"
                                    RequiredError="Campo Obligatorio"
                                    Class="mb-4">
                                @foreach (var familia in listaFamilias)
                                {
                                    <MudSelectItem Value="@familia">@familia</MudSelectItem>
                                }
                            </MudSelect>

                            <MudCardActions>
                                <MudButton Variant="Variant.Filled"
                                        Color="Color.Primary"
                                        Class="ml-auto"
                                        StartIcon="@Icons.Material.Filled.Save"
                                        OnClick="@AbrirCrearVehiculo">
                                    Registrar Vehículo
                                </MudButton>
                            </MudCardActions>


                        </MudForm>
                    </MudStack>
                </div>
            </MudPopover>

        </MudPaper>

<MudDataGrid T="VehiculoRow"
             Items="@ListaVehiculos"
             Filterable="true"
             Sortable="true"
             QuickFilter="@_quickFilter">

    <ToolBarContent>
        <MudText Typo="Typo.h6">Listado de Vehículos</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_searchString"
                      Placeholder="Buscar por serie, marca o modelo..."
                      Adornment="Adornment.Start"
                      Immediate="true"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"
                      Class="mt-0" />
    </ToolBarContent>

    <Columns>
        <PropertyColumn Property="x => x.Idv" Title="ID" />
        <PropertyColumn Property="x => x.Bastidor" Title="Bastidor" />
        <PropertyColumn Property="x => x.Marca" Title="Marca" />
        <PropertyColumn Property="x => x.Modelo" Title="Modelo" />
        <PropertyColumn Property="x => x.Color" Title="Color" />
        <PropertyColumn Property="x => x.Anio_Vehiculo" Title="Año" />
        <PropertyColumn Property="x => x.Km" Title="Kilometros" />
        <PropertyColumn Property="x => x.Familia" Title="Familia" />
    </Columns>

    <PagerContent>
        <MudDataGridPager T="VehiculoRow" />
    </PagerContent>

</MudDataGrid>

<MudCardActions>
    <MudButton Variant="Variant.Filled"
               Color="Color.Secondary"
               Class="ml-auto"
               DisableElevation="true">
        Eliminar Vehiculo
    </MudButton>
</MudCardActions>

</MudItem>
</MudGrid>

@code {

    private string _searchString;
    private List<VehiculoRow> ListaVehiculos = new();

    protected override void OnInitialized()
    {
        AgregarVehiculo("24FA", "FRD982", "Ford", "F-150 Lightning", "Azul Antimateria", 0, "FORD", "2025");
        AgregarVehiculo("24FB", "FRD115", "Ford", "Mustang Mach-E", "Rojo Rápido", 15, "FORD", "2024");

        AgregarVehiculo("24LA", "LNC552", "Lincoln", "Navigator", "Negro Infinito", 5, "LINCOLN", "2025");
        AgregarVehiculo("24LB", "LNC334", "Lincoln", "Aviator", "Plata Radiante", 0, "LINCOLN", "2025");

        AgregarVehiculo("24DA", "DFG771", "Dongfeng", "T5 EVO", "Gris Galaxia", 10, "DONGFENG", "2024");
        AgregarVehiculo("24DB", "DFG882", "Dongfeng", "Rich 6", "Blanco Nieve", 0, "DONGFENG", "2025");

        AgregarVehiculo("24MA", "MZD441", "Mazda", "CX-5", "Rojo Soul Crystal", 12, "MAZDA", "2025");
        AgregarVehiculo("24MB", "MZD992", "Mazda", "MX-5 Miata", "Gris Polimetal", 5, "MAZDA", "2024");

        AgregarVehiculo("24JA", "JTR221", "Jetour", "Dashing", "Azul Eléctrico", 0, "JETOUR", "2025");
        AgregarVehiculo("24JB", "JTR663", "Jetour", "X70 Plus", "Blanco Perla", 8, "JETOUR", "2024");
    }

    private void AgregarVehiculo(string idv, string bastidor, string marca,
        string modelo, string color, int km, string familia, string anio)
    {
        ListaVehiculos.Add(new VehiculoRow
        {
            Idv = idv,
            Bastidor = bastidor,
            Marca = marca,
            Modelo = modelo,
            Color = color,
            Km = km,
            Familia = familia,
            Anio_Vehiculo = anio
        });

    }

    private bool _quickFilter(VehiculoRow x)
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.Bastidor?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;

        if (x.Marca?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;

        if (x.Modelo?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;

        if (x.Familia?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;

        return false;
    }

    private void NavegarARegistrarVehiculo()
    {
        NavigationManager.NavigateTo("/mantenimientos/vehiculos/registrar_vehiculo");
    }

    public class VehiculoRow
    {
        /*
        public int Id { get; set; }
        public string NoSerie { get; set; }
        public string Marca { get; set; }
        public string Modelo { get; set; }
        public string Concesionario { get; set; }
        public DateTime UltimoServicio { get; set; }
        public int IntervaloDias { get; set; }
        */

        public string Idv { get; set;}
        public string Bastidor { get; set;}
        public string Marca { get; set;}
        public string Modelo { get; set;}
        public string Color { get; set;}
        public int Km { get; set;}
        public string Familia { get; set;}
        public string Anio_Vehiculo { get; set;}

        public DateTime UltimoServicio { get; set; }
        public int IntervaloDias { get; set; }



        public DateTime ProximoServicio =>
            UltimoServicio.AddDays(IntervaloDias);
    }

    public bool _abreCrearVehiculo;

    public void AbrirCrearVehiculo()
    {
        if (_abreCrearVehiculo)
            _abreCrearVehiculo = false;
        else
            _abreCrearVehiculo = true;
    }

        MudForm formulario;

    string noSerie = "";
    string modeloSeleccionado;
    int anioVehiculo = 2024;

    int km = 0;
    string color = "";



    DateTime? fechaLlegada = DateTime.Today;
    DateTime? fechaUltimoMantenimiento = DateTime.Today;
    string concesionarioSeleccionado;
    bool mostrarExito = false;
    string serieGuardada = "";
    string modeloGuardado = "";
    string concesionarioGuardado = "";

    void GuardarVehiculo()
    {
        formulario.Validate();

        if (formulario.IsValid)
        {
            serieGuardada = noSerie;
            modeloGuardado = modeloSeleccionado;
            concesionarioGuardado = concesionarioSeleccionado;
            mostrarExito = true;

            noSerie = "";
            modeloSeleccionado = null;
            concesionarioSeleccionado = null;
            anioVehiculo = 2024;
            fechaLlegada = DateTime.Today;
            fechaUltimoMantenimiento = DateTime.Today;
            formulario.ResetValidation();
        }
    }


    List<string> listaModelos = new List<string>
    {
        "Ford Mustang",
        "Lincoln Navigator",
        "Mazda Mazda 3",
        "Dongfeng T5 Evo",
        "Jetour Dashing",
        "Soueast DX3",
        "Dodge Challenger",
        "Fiat 500",
        "Jeep Wrangler", "Jeep Grand Cherokee", "Jeep Renegade",
        "Peugeot 208",
        "Ram 1500",
    };

    List<string> listaFamilias = new List<string>
    {
        "FORD",
        "MAZDA",
        "DONGFENG",
        "JETOUR",
        "LINCOLN"
    };

}
