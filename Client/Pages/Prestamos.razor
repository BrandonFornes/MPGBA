<MudGrid Class="mt-5" Justify="Justify.Center">
        <MudItem xs = "10" >
            <MudPaper>
                <MudButton Variant="Variant.Filled" Size="Size.Large" Color="Color.Tertiary"
                @onclick="NavegarARegistrar">Agregar Prestamo</MudButton>
                <MudButton Variant="Variant.Filled" Size="Size.Large" Color="Color.Secondary"
                @onclick="NavegarADevolver">Devolver Prestamo</MudButton>
            </MudPaper>
     
           <MudTable Items="@PrestamosH.Take(4)" Hover="true" Breakpoint="Breakpoint.Sm"  LoadingProgressColor="Color.Info">
            <HeaderContent>
                <MudTh>Id</MudTh>
                <MudTh>IdHerramienta</MudTh>
                <MudTh>CodigoEncargado</MudTh>
                <MudTh>NombreEncargado</MudTh>
                <MudTh>FechaSolicitud</MudTh>
            </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Id">@context.Id</MudTd>
                    <MudTd DataLabel="IdHerramienta">@context.IdHerramienta</MudTd>
                    <MudTd DataLabel="CodigoEncargado">@context.CodigoEncargado</MudTd>
                    <MudTd DataLabel="NombreEncargado">@context.NombreEncargado</MudTd>
                    <MudTd DataLabel="FechaSolicitud">
                        @context.FechaSolicitud.ToString("dd/MM/yyyy")
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudItem>

</MudGrid>
