@page "/prestamos"
@inject NavigationManager NavigationManager
@using MudBlazor

<MudGrid Class="mt-5" Justify="Justify.Center">
    <MudItem xs="10">
        <MudPaper Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled" Size="Size.Large" Color="Color.Tertiary" 
                       @onclick="NavegarARegistrarPrestamo">Agregar Prestamo</MudButton>
            <MudButton Variant="Variant.Filled" Size="Size.Large" Color="Color.Info"
                       @onclick="NavegarADevolverPrestamo">Devolver Prestamo</MudButton>
        </MudPaper>

        <MudTable Items="@PrestamosH" Filter="new Func<Prestamo, bool>(FilterFunc1)" @bind-SelectedItem="selectedItem1">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Lista de Prestamos</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="searchString1" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>IdPrestamo</MudTh>
                <MudTh>IdHerramienta</MudTh>
                <MudTh>CodigoEncargado</MudTh>
                <MudTh>NombreEncargado</MudTh>
                <MudTh>FechaSolicitud</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="IdPrestamo">@context.Id</MudTd>
                <MudTd DataLabel="IdHerramienta">@context.IdHerramienta</MudTd>
                <MudTd DataLabel="CodigoEncargado">@context.CodigoEncargado</MudTd>
                <MudTd DataLabel="NombreEncargado">@context.NombreEncargado</MudTd>
                <MudTd DataLabel="FechaSolicitud">@context.FechaSolicitud.ToString("dd/MM/yyyy")</MudTd>
                <MudTd>
                    <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Error">Eliminar</MudButton>
                </MudTd>

            </RowTemplate>

        </MudTable>
    </MudItem>

</MudGrid>
@code {
    private IEnumerable<Prestamo> PrestamosH = new List<Prestamo>

    {
        new Prestamo
        {
            Id = 1,
            IdHerramienta = 101,
            CodigoEncargado = "EMP001",
            NombreEncargado = "Juan Perez",
            FechaSolicitud = DateTime.Today.AddDays(-3)
        },
        new Prestamo
        {
            Id = 2,
            IdHerramienta = 205,
            CodigoEncargado = "EMP002",
            NombreEncargado = "Maria Lopez",
            FechaSolicitud = DateTime.Today.AddDays(-2)
        },
        new Prestamo
        {
            Id = 3,
            IdHerramienta = 309,
            CodigoEncargado = "EMP003",
            NombreEncargado = "Carlos Hernandez",
            FechaSolicitud = DateTime.Today.AddDays(-1)
        },
        new Prestamo
        {
            Id = 4,
            IdHerramienta = 412,
            CodigoEncargado = "EMP004",
            NombreEncargado = "Ana Torres",
            FechaSolicitud = DateTime.Today
        }
    };
    private bool dense = false;
    private bool hover = true;
    private bool striped = false;
    private bool bordered = false;
    private string searchString1 = "";
    private Prestamo selectedItem1 = null;
    private HashSet<Prestamo> selectedItems = new HashSet<Prestamo>();

    private bool FilterFunc1(Prestamo prestamo) => FilterFunc(prestamo, searchString1);

    private bool FilterFunc(Prestamo prestamo, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (prestamo.CodigoEncargado.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (prestamo.NombreEncargado.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    private void NavegarARegistrarPrestamo()
    {
        NavigationManager.NavigateTo("/RegistrarPrestamo");
    }

    private void NavegarADevolverPrestamo()
    {
        NavigationManager.NavigateTo("/DevolverPrestamo");
    }

    class Prestamo
    {
        public int Id { get; set; }
        public int IdHerramienta { get; set; }
        public string CodigoEncargado { get; set; }
        public string NombreEncargado { get; set; }
        public DateTime FechaSolicitud { get; set; }
    }

}