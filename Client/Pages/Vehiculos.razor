@page "/vehiculos"
@using MudBlazor
@inject NavigationManager NavigationManager

<MudGrid Class="mt-5" Justify="Justify.Center">
<MudItem xs="10">

        <MudText Typo="Typo.h3" Class="mb-4">
            Vehículos
        </MudText>

        <MudPaper Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       Color="Color.Tertiary"
                       @onclick="NavegarARegistrarVehiculo">
                Registrar Vehículo
            </MudButton>
        </MudPaper>

<MudDataGrid T="VehiculoRow"
             Items="@ListaVehiculos"
             Filterable="true"
             Sortable="true"
             QuickFilter="@_quickFilter">

    <ToolBarContent>
        <MudText Typo="Typo.h6">Listado de Vehículos</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_searchString"
                      Placeholder="Buscar por serie, marca o modelo..."
                      Adornment="Adornment.Start"
                      Immediate="true"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"
                      Class="mt-0" />
    </ToolBarContent>

    <Columns>
        <PropertyColumn Property="x => x.Id" Title="ID" />
        <PropertyColumn Property="x => x.NoSerie" Title="No. Serie" />
        <PropertyColumn Property="x => x.Marca" Title="Marca" />
        <PropertyColumn Property="x => x.Modelo" Title="Modelo" />
        <PropertyColumn Property="x => x.Concesionario" Title="Concesionario" />
    </Columns>

    <PagerContent>
        <MudDataGridPager T="VehiculoRow" />
    </PagerContent>

</MudDataGrid>

<MudCardActions>
    <MudButton Variant="Variant.Filled"
               Color="Color.Secondary"
               Class="ml-auto"
               DisableElevation="true">
        Eliminar Vehiculo
    </MudButton>
</MudCardActions>

</MudItem>
</MudGrid>

@code {

    private string _searchString;
    private List<VehiculoRow> ListaVehiculos = new();

    protected override void OnInitialized()
    {
        AgregarVehiculo(101, "FRD-2024-X", "Ford", "Ranger Raptor", "FORD CIUDAD OBREGON");
        AgregarVehiculo(102, "MZD-5544-Y", "Mazda", "CX-5", "MAZDA LOS MOCHIS");
        AgregarVehiculo(103, "JEEP-WRG-4X4", "Jeep", "Wrangler Rubicon", "JEEP CIUDAD OBREGON");
        AgregarVehiculo(101, "FRD-2024-X", "Ford", "Ranger Raptor", "FORD CIUDAD OBREGON");
        AgregarVehiculo(102, "MZD-5544-Y", "Mazda", "CX-5", "MAZDA LOS MOCHIS");
        AgregarVehiculo(103, "DFG-8888-Z", "Dongfeng", "Aeolus T5 Evo", "DONGFENG OBREGON");
        AgregarVehiculo(104, "PEU-2008-GT", "Peugeot", "2008 GT", "PEUGEOT CIUDAD OBREGON");
        AgregarVehiculo(105, "JEEP-WRG-4X4", "Jeep", "Wrangler Rubicon", "JEEP CIUDAD OBREGON");
        AgregarVehiculo(106, "RAM-700-LRAM", "Ram", "700 Laramie", "RAM TRES RIOS");
        AgregarVehiculo(107, "JET-X70-PLUS", "Jetour", "X70 Plus", "JETOUR MAZATLAN");
        AgregarVehiculo(108, "LNC-NVG-BLK", "Lincoln", "Navigator", "LINCOLN CULIACAN");
        AgregarVehiculo(109, "FIA-PLS-ABTH", "Fiat", "Pulse Abarth", "FIAT TRES RIOS");
        AgregarVehiculo(110, "BST-B70-TURB", "Bestune", "B70", "BESTUNE OBREGON");
        AgregarVehiculo(111, "JIM-REMAX-42", "JIM", "Re-Max S", "JIM HERMOSILLO");
        AgregarVehiculo(112, "DGE-ATT-SXT", "Dodge", "Attitude", "DODGE CIUDAD OBREGON");
        AgregarVehiculo(113, "VOL-XC60-HYB", "Volvo", "XC60 Recharge", "VOLVO CULIACAN");
    }

    private void AgregarVehiculo(int id, string serie, string marca,
        string modelo, string concesionario)
    {
        ListaVehiculos.Add(new VehiculoRow
        {
            Id = id,
            NoSerie = serie,
            Marca = marca,
            Modelo = modelo,
            Concesionario = concesionario,
        });
    }

    private bool _quickFilter(VehiculoRow x)
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.NoSerie?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;

        if (x.Marca?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;

        if (x.Modelo?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;

        if (x.Concesionario?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;

        return false;
    }

    private void NavegarARegistrarVehiculo()
    {
        NavigationManager.NavigateTo("/registro_vehiculos");
    }

    public class VehiculoRow
    {
        public int Id { get; set; }
        public string NoSerie { get; set; }
        public string Marca { get; set; }
        public string Modelo { get; set; }
        public string Concesionario { get; set; }
        public DateTime UltimoServicio { get; set; }
        public int IntervaloDias { get; set; }

        public DateTime ProximoServicio =>
            UltimoServicio.AddDays(IntervaloDias);
    }
}
