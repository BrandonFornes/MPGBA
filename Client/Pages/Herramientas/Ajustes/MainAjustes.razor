@page "/herramientas/ajustes"
@using MudBlazor
@inject NavigationManager NavigationManager

<MudGrid Class="mt-5" Justify="Justify.Center">
<MudItem xs="10">

        <MudText Typo="Typo.h3" Class="mb-4">
            Herramientas
        </MudText>

        <MudPaper Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       Color="Color.Tertiary"
                       Class="mr-3"
                       OnClick="@AbrirCrearHerramienta">
                Crear Herramienta
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       Color="Color.Info"
                       OnClick="@AbrirCrearTipo">
                Crear Tipo de Herramienta
            </MudButton>

            @*Overlay de Crear Herramienta*@
            <MudOverlay Visible="_abreCrearHerramienta" OnClick="@AbrirCrearHerramienta" DarkBackground="true" ZIndex="5" />

            @*Overlay de Crear Tipo de Herramienta*@
            <MudOverlay Visible="_abreCrearTipo" OnClick="@AbrirCrearTipo" DarkBackground="true" ZIndex="5" />


            @*Popover para crear herramienta*@
            <MudPopover Open="@_abreCrearHerramienta" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" RelativePanel="true">
                
                <MudText Typo="Typo.h5" Class="pa-4">
                    Crear Herramienta
                </MudText>
                
                <div style="width: 1000px; heigth: auto;" class="pa-5">
                    <MudStack Spacing="4">
                        <MudForm @ref="formulario" Spacing="9">
                            <MudTextField @bind-Value="Nombre" Label="Nombre de Herramienta" Variant="Variant.Text"></MudTextField>

                            <MudTextField @bind-Value="Etiqueta" Label="Etiqueta" Variant="Variant.Text"></MudTextField>

                            <MudTextField @bind-Value="Descripcion" Label="Descripcion (Opcional)" Variant="Variant.Text"></MudTextField>

                            <MudSelect T="string" Label="Tipo de Herramienta" MultiSelection="false" @bind-Value="_value" @bind-SelectedValue="_options">
                                @foreach (var state in _states)
                                {
                                    <MudSelectItem T="string" Value="@state">@state</MudSelectItem>
                                }
                            </MudSelect>

                            <MudTextField T="DateTime?" Format="yyyy-MM-dd" Label="Fecha de Compra" InputType="InputType.Date" />

                            <MudTextField @bind-Value="Marca" Label="Marca de Herramienta" Variant="Variant.Text"></MudTextField>

                            <MudCardActions>
                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary " Class="ml-auto" OnClick="@AbrirCrearHerramienta">CREAR</MudButton>
                            </MudCardActions>

                        </MudForm>
                    </MudStack>
                </div>
            </MudPopover>

            @*Popover para crear herramienta*@
            <MudPopover Open="@_abreCrearTipo" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" RelativePanel="true">
                
                <MudText Typo="Typo.h5" Class="pa-4">
                    Crear Herramienta
                </MudText>
                
                <div style="width: 1000px; heigth: auto;" class="pa-5">
                    <MudStack Spacing="4">
                        <MudForm @ref="formulario2" Spacing="9">
                            <MudTextField @bind-Value="Nombre" Label="Tipo de Herramienta" Variant="Variant.Text"></MudTextField>

                            <MudCardActions>
                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" OnClick="@AbrirCrearTipo">CREAR</MudButton>
                            </MudCardActions>
                        </MudForm>
                    </MudStack>
                </div>
            </MudPopover>

        </MudPaper>

<MudDataGrid T="Herramienta"
             Items="@Herramientas"
             Filterable="true"
             Sortable="true"
             QuickFilter="@_quickFilter"
             @bind-SelectedItem="selectedItem">

    <ToolBarContent>
        <MudText Typo="Typo.h6">Lista de Herramientas</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_searchString"
                      Placeholder="Buscar por nombre, etiqueta o tipo..."
                      Adornment="Adornment.Start"
                      Immediate="true"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"
                      Class="mt-0" />
    </ToolBarContent>

    <Columns>
        <PropertyColumn Property="x => x.Id" Title="ID" Sortable="true" />
        <PropertyColumn Property="x => x.Etiqueta" Title="Etiqueta" />
        <PropertyColumn Property="x => x.NombreHerramienta" Title="Nombre" />
        <PropertyColumn Property="x => x.TipoHerramienta" Title="Tipo" />

        <TemplateColumn Title="Disponible">
            <CellTemplate>
                @if (context.Item.Disponible)
                {
                    <MudChip Color="Color.Success" Size="Size.Small">
                        Disponible
                    </MudChip>
                }
                else
                {
                    <MudChip Color="Color.Error" Size="Size.Small">
                        No disponible
                    </MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager T="Herramienta" />
    </PagerContent>

</MudDataGrid>

<MudCardActions>
    <MudButton Variant="Variant.Filled"
               Color="Color.Secondary"
               Class="ml-auto"
               DisableElevation="true">
        Eliminar Herramienta
    </MudButton>
</MudCardActions>

</MudItem>
</MudGrid>

@code {

    private string _searchString;
    private Herramienta selectedItem;

    private List<Herramienta> Herramientas = new()
    {
        new Herramienta { Id = 1, Etiqueta = "HRM-001", NombreHerramienta = "Martillo", Disponible = true, TipoHerramienta = "Manual" },
        new Herramienta { Id = 2, Etiqueta = "HRM-002", NombreHerramienta = "Taladro Electrico", Disponible = false, TipoHerramienta = "Electrica" },
        new Herramienta { Id = 3, Etiqueta = "HRM-003", NombreHerramienta = "Llave Inglesa", Disponible = true, TipoHerramienta = "Manual" },
        new Herramienta { Id = 4, Etiqueta = "HRM-004", NombreHerramienta = "Esmeril", Disponible = true, TipoHerramienta = "Electrica" },
        new Herramienta { Id = 5, Etiqueta = "HRM-005", NombreHerramienta = "Gato Hidraulico", Disponible = true, TipoHerramienta = "Hidraulica" },
        new Herramienta { Id = 6, Etiqueta = "HRM-006", NombreHerramienta = "Compresor Aire", Disponible = false, TipoHerramienta = "Neumatica" }
    };

    private bool _quickFilter(Herramienta x)
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.NombreHerramienta?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;

        if (x.Etiqueta?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;

        if (x.TipoHerramienta?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;

        return false;
    }

    private void NavegarCrearHerramienta()
    {
        NavigationManager.NavigateTo("/herramientas/ajustes/crear_herramienta");
    }

    private void NavegarCrearTipoDeHerramienta()
    {
        NavigationManager.NavigateTo("/herramientas/ajustes/crear_tipo_herramienta");
    }

    public class Herramienta
    {
        public int Id { get; set; }
        public string Etiqueta { get; set; }
        public string NombreHerramienta { get; set; }
        public bool Disponible { get; set; }
        public string TipoHerramienta { get; set; }
    }


    public bool _abreCrearHerramienta;

    public void AbrirCrearHerramienta()
    {
        if (_abreCrearHerramienta)
            _abreCrearHerramienta = false;
        else
            _abreCrearHerramienta = true;
    }

    public bool _abreCrearTipo;

    public void AbrirCrearTipo()
    {
        if (_abreCrearTipo)
            _abreCrearTipo = false;
        else
            _abreCrearTipo = true;
    }
    
    public string Nombre { get; set; }
    public string Etiqueta { get; set; }
    public string Descripcion { get; set; }
    public string Marca { get; set; }
    private string _value = "";
    private IEnumerable<string> _options = new HashSet<string> { };
    private readonly string[] _states = new[]
    {
        "Manual",
        "Eléctricas",
        "Neumáticas",
        "Hidráulicas",
        "Medicion",
    };

    MudForm formulario;

    MudForm formulario2;

}
