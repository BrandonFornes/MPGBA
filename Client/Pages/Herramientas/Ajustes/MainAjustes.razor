@page "/herramientas/ajustes"
@using MudBlazor
@inject NavigationManager NavigationManager
@inject HttpClient Http

@using AdminHerramientas.Shared.Models


<MudGrid Class="mt-5" Justify="Justify.Center">
    <MudItem xs="10">

        <MudText Typo="Typo.h3" Class="mb-4">
            Herramientas
        </MudText>

        <MudPaper Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       Color="Color.Tertiary"
                       Class="mr-3"
                       OnClick="@AbrirCrearHerramienta">
                Crear Herramienta
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       Color="Color.Info"
                       OnClick="@AbrirCrearTipo">
                Crear Tipo de Herramienta
            </MudButton>

            @*Overlay de Crear Herramienta*@
            <MudOverlay Visible="_abreCrearHerramienta" OnClick="@AbrirCrearHerramienta" DarkBackground="true" ZIndex="5" />

            @*Overlay de Crear Tipo de Herramienta*@
            <MudOverlay Visible="_abreCrearTipo" OnClick="@AbrirCrearTipo" DarkBackground="true" ZIndex="5" />


            @*Popover para crear herramienta*@
            <MudPopover Open="@_abreCrearHerramienta" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" RelativePanel="true">

                <MudText Typo="Typo.h5" Class="pa-4">
                    Crear Herramienta
                </MudText>

                <div style="width: 1000px; height: auto;" class="pa-5">
                    <MudStack Spacing="4">
                        <MudForm @ref="formulario" Spacing="9" OnValidSubmit="CrearHerramienta">
                            <MudSelect T="Herramienta" Label="Tipo de Herramienta" @bind-Value="_value">
                                @foreach (Herramienta herramienta in TiposHerramientas)
                                {
                                    <MudSelectItem Value="@herramienta">@herramienta.Tipo</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField @bind-Value="DescripcionHerramienta" Label="Descripcion de Herramienta" Variant="Variant.Text"></MudTextField>

                            <MudTextField @bind-Value="EtiquetaHerramienta" Label="Etiqueta" Variant="Variant.Text"></MudTextField>

                            <MudTextField T="DateTime?" @bind-Value="FechaHerramienta" Format="yyyy-MM-dd" Label="Fecha de Compra" InputType="InputType.Date" />

                            <MudCardActions>
                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" OnClick="@AbrirCrearHerramienta">CREAR</MudButton>
                            </MudCardActions>

                        </MudForm>
                    </MudStack>
                </div>
            </MudPopover>

            @*Popover para crear tipo de herramienta*@
            <MudPopover Open="@_abreCrearTipo" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" RelativePanel="true">

                <MudText Typo="Typo.h5" Class="pa-4">
                    Crear Herramienta
                </MudText>

                <div style="width: 1000px; height: auto;" class="pa-5">
                    <MudStack Spacing="4">
                        <MudForm @ref="formulario2" Spacing="9">
                            <MudTextField @bind-Value="NombreHerramienta" Label="Tipo de Herramienta" Variant="Variant.Text"></MudTextField>

                            <MudCardActions>
                                <MudButton ButtonType="ButtonType.Submit" OnClick="CrearTipoHerramienta" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto">CREAR</MudButton>
                            </MudCardActions>
                        </MudForm>
                    </MudStack>
                </div>
            </MudPopover>

        </MudPaper>

        <MudDataGrid T="HerramientasDetalle"
                     Items="@Herramientas"
                     Filterable="true"
                     Sortable="true"
                     QuickFilter="@_quickFilter"
                     @bind-SelectedItem="selectedItem">

            <ToolBarContent>
                <MudText Typo="Typo.h6">Lista de Herramientas</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString"
                              Placeholder="Buscar por nombre, etiqueta o tipo..."
                              Adornment="Adornment.Start"
                              Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0" />
            </ToolBarContent>

            <Columns>
                <PropertyColumn Property="x => x.Id" Title="ID" Sortable="true" />
                <PropertyColumn Property="x => x.Descripcion" Title="Etiqueta" />
                <PropertyColumn Property="x => x.Activo" Title="Nombre" />
                <PropertyColumn Property="x => x.FkIdHerramienta" Title="Tipo" />

                <TemplateColumn Title="Disponible">
                    <CellTemplate>
                        @if (context.Item.Disponible == true)
                        {
                            <MudChip Color="Color.Success" Size="Size.Small">
                                Disponible
                            </MudChip>
                        }
                        else
                        {
                            <MudChip Color="Color.Error" Size="Size.Small">
                                No disponible
                            </MudChip>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>

            <PagerContent>
                <MudDataGridPager T="HerramientasDetalle" />
            </PagerContent>

        </MudDataGrid>

        <MudCardActions>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Class="ml-auto"
                       DisableElevation="true">
                Eliminar Herramienta
            </MudButton>
        </MudCardActions>

    </MudItem>
</MudGrid>

@code {

    private string _searchString;
    private HerramientasDetalle selectedItem;
    private List<HerramientasDetalle> Herramientas = new();
    private List<Herramienta> TiposHerramientas = new();

    protected override async Task OnInitializedAsync()
    {
        var task1 = Http.GetFromJsonAsync<List<HerramientasDetalle>>("api/herramientasdetalles");
        var task2 = Http.GetFromJsonAsync<List<Herramienta>>("api/herramienta");

        Herramientas = await task1 ?? new();
        TiposHerramientas = await task2 ?? new();
    }

    protected async Task CrearTipoHerramienta()
    {
        Herramienta herramienta = new Herramienta
        {
            Tipo = NombreHerramienta,
            FechaModificacion = DateTime.Today,
            UsuarioModifico = 1
        };
        var response = await Http.PostAsJsonAsync("api/herramienta", herramienta);

        if (response.IsSuccessStatusCode)
        {
            NombreHerramienta = "";
            _abreCrearTipo = false;
            //Recargar lista
            TiposHerramientas = await Http.GetFromJsonAsync<List<Herramienta>>("api/herramienta");
        }


    }

    protected async Task CrearHerramienta()
    {
        HerramientasDetalle herramientasDetalle = new HerramientasDetalle
        {
            Descripcion = DescripcionHerramienta,
            Etiqueta = EtiquetaHerramienta,
            FkIdHerramienta = TiposHerramientas.FirstOrDefault(x => x.Tipo == _value.Tipo)?.Id ?? 0,
            Disponible = true,
            FechaModificacion = FechaHerramienta,
            UsuarioModifico = 1
        };
        var response = await Http.PostAsJsonAsync("api/herramientasdetalles", herramientasDetalle);
        if (response.IsSuccessStatusCode)
        {
            DescripcionHerramienta = "";
            EtiquetaHerramienta = "";
            _value = null;
            _abreCrearHerramienta = false;
        }
    }

    private bool _quickFilter(HerramientasDetalle x)
    {
        // if (string.IsNullOrWhiteSpace(_seachString))
        //     return true;

        // if (x.NombreHerramienta?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
        //     return true;

        // if (x.Etiqueta?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
        //     return true;

        // if (x.TipoHerramienta?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
        //     return true;

        return false;
    }


    public bool _abreCrearHerramienta;

    public void AbrirCrearHerramienta()
    {
        if (_abreCrearHerramienta)
            _abreCrearHerramienta = false;
        else
            _abreCrearHerramienta = true;
    }

    public bool _abreCrearTipo;

    public void AbrirCrearTipo()
    {
        if (_abreCrearTipo)
            _abreCrearTipo = false;
        else
            _abreCrearTipo = true;
    }

    public string Nombre { get; set; }
    public string NombreHerramienta { get; set; }
    public string EtiquetaHerramienta { get; set; }
    public string DescripcionHerramienta { get; set; }
    public DateTime FechaHerramienta { get; set; }
    private Herramienta _value;
    private IEnumerable<string> _options = new HashSet<string> { };
    MudForm formulario;

    MudForm formulario2;

}
