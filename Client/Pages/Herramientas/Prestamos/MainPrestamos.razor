@page "/herramientas/prestamos"
@using MudBlazor
@using AdminHerramientas.Shared.Models
@inject NavigationManager NavigationManager
@inject HttpClient Http

<MudGrid Class="mt-5" Justify="Justify.Center">
    <MudItem xs="10">

        <MudText Typo="Typo.h3" Class="mb-4">
            Préstamos
        </MudText>

        <MudPaper Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       Color="Color.Tertiary"
                       Class="mr-3"
                       OnClick="@AbrirPrestamo">
                Agregar Préstamo
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       Color="Color.Info"
                       OnClick="@AbrirDevolucion">
                Devolver Préstamo
            </MudButton>

            @*Overlay de Prestamo*@
            <MudOverlay Visible="_abrePrestamo" OnClick="@AbrirPrestamo" DarkBackground="true" ZIndex="5" />

            @*Overlay de Devolucion*@
            <MudOverlay Visible="_abreDevolucion" OnClick="@AbrirDevolucion" DarkBackground="true" ZIndex="5" />

            @*Popover para agregar el prestamo a prestamo maestro*@
            <MudPopover Open="@_abrePrestamo" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" RelativePanel="true">

                <MudText Typo="Typo.h5" Class="pa-4">
                    Registrar Préstamo
                </MudText>

                <div style="width: 1000px; height: auto;" class="pa-5">
                    <MudStack Spacing="4">
                        <MudForm @ref="formularioPrestamo" Spacing="9">

                            <MudSelect T="Operario"
                                       Label="Ingrese Código Del Operario"
                                       @bind-Value="operarioSeleccionado"
                                       Variant="Variant.Outlined"
                                       Required="true"
                                       RequiredError="Campo Obligatorio"
                                       AnchorOrigin="Origin.BottomCenter"
                                       Class="mb-4">
                                @foreach (Operario operario in ListaOperarios)
                                {
                                    <MudSelectItem Value="@operario">@operario.Codigo</MudSelectItem>
                                }
                            </MudSelect>

                            @if ((operarioSeleccionado) != null)
                            {
                                <MudTextField @bind-Value="motivoPrestamo" Label="Motivo" Variant="Variant.Outlined" Required="true" Class="mb-4" />
                                <MudTextField @bind-Value="codigoServicio" Label="Código de Servicio" Variant="Variant.Outlined" Required="true" Class="mb-4" />

                                <MudSelect T="HerramientasDetalle"
                                           Label="Escoge la(s) herramientas"
                                           Variant="Variant.Outlined"
                                           MultiSelection="true"
                                           Required="true"
                                           RequiredError="Debes seleccionar al menos una herramienta"
                                           Class="mb-4"
                                           AnchorOrigin="Origin.BottomCenter"
                                           ToStringFunc="@(h => h == null ? null : $"{h.Descripcion} - {h.Etiqueta}")"
                                           @bind-SelectedValues="_herramientasSeleccionadas">
                                           
                                    @foreach (var herramienta in HerramientasDisponibles)
                                    {
                                        <MudSelectItem Value="@herramienta">@herramienta.Descripcion</MudSelectItem>
                                    }
                                </MudSelect>

                                <MudTextField T="string"
                                              Label="NIP Encargado"
                                              @bind-Value="nipEncargado"
                                              Placeholder="Ingrese NIP único"
                                              InputType="InputType.Password"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              RequiredError="Campo Obligatorio"
                                              Class="mb-4" />

                                <MudCardActions>
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Class="ml-auto"
                                               StartIcon="@Icons.Material.Filled.Save"
                                               OnClick="GuardarPrestamo">
                                        Registrar Préstamo
                                    </MudButton>
                                </MudCardActions>
                            }
                        </MudForm>
                    </MudStack>
                </div>
            </MudPopover>

            @*Popover para devolver el prestamo (Omitido su formulario completo por brevedad, mantener tu diseño)*@
            <MudPopover Open="@_abreDevolucion" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" RelativePanel="true">
                <MudText Typo="Typo.h5" Class="pa-4">Registrar Devolución</MudText>

                <div style="width: 1000px; height: auto;" class="pa-5">
                    <MudStack Spacing="4">
                        <MudForm @ref="formularioDevolucion" Spacing="9">

                            @* 1. Selección del Operario *@
                            <MudSelect T="Operario"
                                       Label="Código del Operario que devuelve"
                                       @bind-Value="operarioDevolucion"
                                       Variant="Variant.Outlined"
                                       Required="true"
                                       RequiredError="Seleccione el operario"
                                       Class="mb-4"
                                       AnchorOrigin="Origin.BottomCenter">
                                @foreach (Operario operario in ListaOperarios)
                                {
                                    <MudSelectItem Value="@operario">@operario.Codigo</MudSelectItem>
                                }
                            </MudSelect>

                            @if (operarioDevolucion != null)
                            {
                                @* 2. Selección de Herramientas (Solo las que tiene prestadas) *@
                                <MudSelect T="PrestamosDetalle"
                                           Label="Herramientas a devolver"
                                           Variant="Variant.Outlined"
                                           MultiSelection="true"
                                           Required="true"
                                           RequiredError="Seleccione al menos una herramienta"
                                           Class="mb-4"
                                           ToStringFunc="@(d => ObtenerNombreHerramienta(d.FkIdHerramienta))"
                                           @bind-SelectedValues="_detallesADevolver">
                                    @foreach (var detalle in ObtenerHerramientasPrestadas(operarioDevolucion.Codigo))
                                    {
                                        <MudSelectItem Value="@detalle">@ObtenerNombreHerramienta(detalle.FkIdHerramienta)</MudSelectItem>
                                    }
                                </MudSelect>

                                @* 3. Comentario de devolución *@
                                <MudTextField @bind-Value="comentarioDevolucion"
                                              Label="Comentario de entrega (Opcional)"
                                              Variant="Variant.Outlined"
                                              Lines="2"
                                              Class="mb-4" />

                                <MudCardActions>
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Success"
                                               Class="ml-auto"
                                               StartIcon="@Icons.Material.Filled.AssignmentReturn"
                                               OnClick="GuardarDevolucion">
                                        Procesar Devolución
                                    </MudButton>
                                </MudCardActions>
                            }
                        </MudForm>
                    </MudStack>
                </div>
            </MudPopover>

        </MudPaper>

        <MudDataGrid T="Prestamo"
                     Items="@ListaPrestamos"
                     Filterable="true"
                     Sortable="true"
                     QuickFilter="@_quickFilter">

            <ToolBarContent>
                <MudText Typo="Typo.h6">Lista de Préstamos</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString"
                              Placeholder="Buscar por código..."
                              Adornment="Adornment.Start"
                              Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0" />
            </ToolBarContent>

            <Columns>
                <PropertyColumn Property="x => x.IdPrestamos" Title="ID" Sortable="true" />
                <PropertyColumn Property="x => x.FkCodigoOperario" Title="Operario" />
                <PropertyColumn Property="x => x.FechaSolicitud" Title="Fecha Solicitud" Format="dd/MM/yyyy" />
                <TemplateColumn Title="Acciones">
                    <CellTemplate>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Warning"
                                   Size="Size.Small"
                                   OnClick="@(() => {AbrirDevolucion();
                                                    operarioDevolucion = ListaOperarios.FirstOrDefault(o => o.Codigo ==  context.Item.FkCodigoOperario); })">
                                    Devolver
                        </MudButton>
                    </CellTemplate>
                </TemplateColumn>

                <HierarchyColumn T="Prestamo" />
            </Columns>
            <ChildRowContent>
                <MudCard Elevation="0" Class="pa-4" Style="background-color: #f5f5f5;">
                    <MudText Typo="Typo.subtitle1" Class="mb-2"><strong>Herramientas del Préstamo #@context.Item.IdPrestamos</strong></MudText>

                    <MudTable Items="@context.Item.PrestamosDetalles" Context="detalle" Hover="true" Elevation="1" Dense="true">
                        <HeaderContent>
                            <MudTh>ID Detalle</MudTh>
                            <MudTh>Herramienta</MudTh>
                            <MudTh>Comentario</MudTh>
                            <MudTh>Fecha Final</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="ID Detalle">@detalle.Id</MudTd>
                            <MudTd DataLabel="Herramienta">@ObtenerNombreHerramienta(detalle.FkIdHerramienta)</MudTd>
                            <MudTd DataLabel="Comentario">@(string.IsNullOrWhiteSpace(detalle.Comentario) ? "Sin comentarios" : detalle.Comentario)</MudTd>
                            <MudTd DataLabel="Fecha Final">@(detalle.FechaEntrega?.ToString("dd/MM/yyyy") ?? "Aún en préstamo")</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCard>
            </ChildRowContent>

            <PagerContent>
                <MudDataGridPager T="Prestamo" />
            </PagerContent>

        </MudDataGrid>

    </MudItem>
</MudGrid>

@code {
    private bool _abrePrestamo;
    private bool _abreDevolucion;
    private string _searchString;

    // Formularios y datos capturados
    private MudForm formularioPrestamo;
    private Operario operarioSeleccionado;
    private string motivoPrestamo;
    private string codigoServicio;
    private string nipEncargado;
    private MudForm formularioDevolucion;
    private Operario operarioDevolucion;
    private string comentarioDevolucion;
    private IEnumerable<PrestamosDetalle> _detallesADevolver = new HashSet<PrestamosDetalle>();

    // Listas de datos reales provenientes de la BD
    private List<Prestamo> ListaPrestamos = new();
    private List<Operario> ListaOperarios = new();
    private List<HerramientasDetalle> HerramientasDisponibles = new();
    private List<HerramientasDetalle> ListaTodasHerramientas = new();
    private IEnumerable<HerramientasDetalle> _herramientasSeleccionadas = new HashSet<HerramientasDetalle>();
    private Dictionary<int, HerramientasDetalle> _diccionarioHerramientas = new();

    // Mock de códigos de operarios (idealmente cargar desde API de Operarios)


    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        var task1 = Http.GetFromJsonAsync<List<Prestamo>>("api/prestamos");
        var task2 = Http.GetFromJsonAsync<List<HerramientasDetalle>>("api/herramientasdetalles");
        var task3 = Http.GetFromJsonAsync<List<Operario>>("api/operario");

        await Task.WhenAll(task1, task2, task3);

        ListaPrestamos = await task1 ?? new();
        ListaTodasHerramientas = await task2 ?? new();
        ListaOperarios = await task3 ?? new();

        _diccionarioHerramientas = ListaTodasHerramientas.ToDictionary(h => h.Id, h => h);
        HerramientasDisponibles = ListaTodasHerramientas.Where(h => h.Disponible == true).ToList();

    }

    private string ObtenerNombreHerramienta(int idHerramienta)
    {
        if (_diccionarioHerramientas.TryGetValue(idHerramienta, out var h))
        {
            return $"{h.Descripcion} - {h.Etiqueta}";
        }
        return $"ID : {idHerramienta} ";
    }
    private List<PrestamosDetalle> ObtenerHerramientasPrestadas(string codigoOperario)
    {
        return ListaPrestamos
            .Where(p => p.FkCodigoOperario == codigoOperario)
            .SelectMany(p => p.PrestamosDetalles)
            .Where(d => d.FechaEntrega == null)
            .ToList();
    }


    private async Task GuardarDevolucion()
    {
        await formularioDevolucion.Validate();

        if (formularioDevolucion.IsValid && _detallesADevolver.Any())
        {
            var listaParaEnviar = _detallesADevolver.ToList();

            foreach (var detalle in listaParaEnviar)
            {
                detalle.FechaEntrega = DateTime.Now;
                detalle.Comentario = comentarioDevolucion;
                detalle.FechaModificacion = DateTime.Now;
                detalle.UsuarioModifico = 0;
                detalle.FkIdPrestamoNavigation = null;
            }
            var response = await Http.PutAsJsonAsync("api/prestamos/devolver", listaParaEnviar);

            if (response.IsSuccessStatusCode)
            {
                comentarioDevolucion = "";
                operarioDevolucion = null;
                _detallesADevolver = new HashSet<PrestamosDetalle>();
                _abreDevolucion = false;
                await CargarDatos();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Falló la devolución: {error}");
            }
        }
    }

    private async Task GuardarPrestamo()
    {
        await formularioPrestamo.Validate();

        if (formularioPrestamo.IsValid && _herramientasSeleccionadas.Any())
        {
            var nuevoPrestamo = new Prestamo
            {
                FkCodigoOperario = operarioSeleccionado.Codigo,
                FkCodigoEncargado = "OP004", // TODO Validar el nip
                Motivo = motivoPrestamo,
                CodigoServicio = codigoServicio,
                FechaSolicitud = DateTime.Now,
                FechaModificacion = DateTime.Now,
                UsuarioModifico = 1,
                Activo = true,
                PrestamosDetalles = _herramientasSeleccionadas.Select(h => new PrestamosDetalle
                {
                    FkIdHerramienta = h.Id,
                    FechaEntrega = null,
                    Activo = true,
                    FechaModificacion = DateTime.Now,
                    UsuarioModifico = 0
                }).ToList()
            };

            // 3. Enviar el POST a tu API
            var response = await Http.PostAsJsonAsync("api/prestamos", nuevoPrestamo);

            if (response.IsSuccessStatusCode)
            {
                LimpiarFormulario();
                _abrePrestamo = false;
                await CargarDatos();
            }
            else
            {
                Console.WriteLine("Error al crear el préstamo: " + response.ReasonPhrase);
            }
        }
    }

    private void LimpiarFormulario()
    {
        operarioSeleccionado = null;
        motivoPrestamo = string.Empty;
        codigoServicio = string.Empty;
        nipEncargado = string.Empty;
        _herramientasSeleccionadas = new HashSet<HerramientasDetalle>();
    }

    private bool _quickFilter(Prestamo x)
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        if (x.FkCodigoOperario?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (x.FkCodigoEncargado?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        return false;
    }

    public void AbrirPrestamo() => _abrePrestamo = !_abrePrestamo;
    public void AbrirDevolucion() => _abreDevolucion = !_abreDevolucion;
}