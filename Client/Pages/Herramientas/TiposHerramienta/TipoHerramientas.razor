@page "/herramientas/TiposHerramienta"
@using MudBlazor
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject ISnackbar Snackbar
@using AdminHerramientas.Shared.Models

<MudGrid Class="mt-5" Justify="Justify.Center">
    <MudItem xs="10">

        <MudText Typo="Typo.h3" Class="mb-4">
            Tipos De Herramientas
        </MudText>

        <MudPaper Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       Color="Color.Info"
                       OnClick="@AbrirCrearTipo">
                Crear Tipo de Herramienta
            </MudButton>
                       
            @*Overlay de Crear Tipo de Herramienta*@
            <MudOverlay Visible="_abreCrearTipo" OnClick="@AbrirCrearTipo" DarkBackground="true" ZIndex="5" />
              
            @*Popover para crear tipo de herramienta*@
            <MudPopover Open="@_abreCrearTipo" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" RelativePanel="true">

                <MudText Typo="Typo.h5" Class="pa-4">
                    @($"{_modoActual} Tipo de Herramienta")
                </MudText>

                <div style="width: 1000px; height: auto;" class="pa-5">
                    <MudStack Spacing="4">
                        <MudForm @ref="formulario" Spacing="9">
                            <MudTextField @bind-Value="NombreHerramienta" Label="Tipo de Herramienta" Required="true" RequiredError="Campo Obligatorio" Variant="Variant.Text"></MudTextField>

                            <MudCardActions>
                                <MudButton ButtonType="ButtonType.Submit" OnClick="GuardarTipoHerramienta" Variant="Variant.Filled"
                                           Color="@(_modoActual == "Eliminar" ? Color.Error : _modoActual == "Editar" ? Color.Warning : Color.Primary)" Class="ml-auto">
                                            @($"{_modoActual}")
                                </MudButton>
                            </MudCardActions>
                        </MudForm>
                    </MudStack>
                </div>
            </MudPopover>

        </MudPaper>

        <MudDataGrid T="Herramienta"
                     Items="@TiposHerramientas"
                     Filterable="true"
                     Sortable="true"
                     QuickFilter="@_quickFilter"
                     @bind-SelectedItem="selectedItem">

            <ToolBarContent>
                <MudText Typo="Typo.h6">Lista de Tipo de Herramientas</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString"
                              Placeholder="Buscar por nombre"
                              Adornment="Adornment.Start"
                              Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0" />
            </ToolBarContent>

            <Columns>
                <PropertyColumn Property="x => x.Id" Title="ID" Sortable="true" />
                <PropertyColumn Property="x => x.Tipo" Title="Nombre" />

                <TemplateColumn Title="Acciones">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small" OnClick="@(() => EditarTipoHerramienta(context.Item))"></MudIconButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => EliminarTipoHerramienta(context.Item))"></MudIconButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>

            <PagerContent>
                <MudDataGridPager T="Herramienta" />
            </PagerContent>

        </MudDataGrid>
    </MudItem>
</MudGrid>



@code {
    public string NombreHerramienta { get; set; }
    MudForm formulario;

    private string _searchString;
    private string _modoActual = "Crear";
    private Herramienta selectedItem;
    private List<Herramienta> TiposHerramientas = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            TiposHerramientas = await Http.GetFromJsonAsync<List<Herramienta>>("api/herramienta") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al cargar datos: " + ex.Message, Severity.Error);
        }
    }

    protected async Task GuardarTipoHerramienta()
    {
        await formulario.Validate();

        if (formulario.IsValid)
        {
            Herramienta herramienta = new Herramienta
            {
                Id = _modoActual == "Editar" || _modoActual == "Eliminar" ? selectedItem.Id : 0,
                Tipo = NombreHerramienta,
                FechaModificacion = DateTime.Today,
                UsuarioModifico = 1,
                Activo = true
            };
            HttpResponseMessage response;
            if (_modoActual == "Crear")
            {
                response = await Http.PostAsJsonAsync("api/herramienta", herramienta);
            }
            else if (_modoActual == "Editar")
            {
                response = await Http.PutAsJsonAsync($"api/herramienta/{herramienta.Id}", herramienta);
            }
            else
            {
                response = await Http.DeleteAsync($"api/herramienta/{herramienta.Id}");
            }
            if (response.IsSuccessStatusCode)
            {
                await CargarDatos();
                AbrirCrearTipo();

            }
        }
    }


    private void EditarTipoHerramienta(Herramienta herramienta)
    {
        selectedItem = herramienta;
        _modoActual = "Editar";
        NombreHerramienta = herramienta.Tipo;
        AbrirCrearTipo();
    }
    private void EliminarTipoHerramienta(Herramienta herramienta)
    {
        selectedItem = herramienta;
        _modoActual = "Eliminar";
        NombreHerramienta = herramienta.Tipo;
        AbrirCrearTipo();
    }

    private bool _quickFilter(Herramienta x)
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        // if (x.Id.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
        //     return true;

        if (x.Tipo?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;



        return false;
    }

    public bool _abreCrearTipo;

    public void AbrirCrearTipo()
    {
        if (_abreCrearTipo)
        {
        _abreCrearTipo = false;
        limpiarFormulario();
        }
        else
            _abreCrearTipo = true;
    }
    public void limpiarFormulario()
    {
        selectedItem = null;
        _modoActual = "Crear";
        NombreHerramienta = "";

    }

}
