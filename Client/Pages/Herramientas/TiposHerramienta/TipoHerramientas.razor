@page "/herramientas/TiposHerramienta"
@using MudBlazor
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject ISnackbar Snackbar
@using AdminHerramientas.Shared.Models

<MudGrid Class="mt-5" Justify="Justify.Center">
    <MudItem xs="10">

        <MudText Typo="Typo.h3" Class="mb-4">
            Tipos De Herramientas
        </MudText>

        <MudPaper Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       Color="Color.Info"
                       OnClick="@AbrirCrearTipo">
                Crear Tipo de Herramienta
            </MudButton>
                       
            @*Overlay de Crear Tipo de Herramienta*@
            <MudOverlay Visible="_abreCrearTipo" OnClick="@AbrirCrearTipo" DarkBackground="true" ZIndex="5" />
              
            @*Popover para crear tipo de herramienta*@
            <MudPopover Open="@_abreCrearTipo" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" RelativePanel="true">

                <MudText Typo="Typo.h5" Class="pa-4">
                    @($"{_modoActual} Tipo de Herramienta")
                </MudText>

                <div style="width: 1000px; height: auto;" class="pa-5">
                    <MudStack Spacing="4">
                        <MudForm @ref="formulario" Spacing="9">
                            <MudTextField @bind-Value="NombreHerramienta" Label="Tipo de Herramienta" Required="true" RequiredError="Campo Obligatorio" Variant="Variant.Text"></MudTextField>

                            @if (HerramientaTipoSeleccionada != null)
                            {
                                <MudSelect T="bool" @bind-Value="_activo" Label="Estado" Variant="Variant.Outlined">
                                    <MudSelectItem Value="true">Activo</MudSelectItem>
                                    <MudSelectItem Value="false">Inactivo</MudSelectItem>
                                </MudSelect>
                            }

                            <MudCardActions>
                                <MudButton ButtonType="ButtonType.Button" OnClick="GuardarTipoHerramienta" Variant="Variant.Filled"
                                           Color="@(_modoActual == "Eliminar" ? Color.Error : _modoActual == "Editar" ? Color.Warning : Color.Primary)"
                                           Class="ml-auto" Disabled="@_procesando">
                                            @(_procesando ? "Procesando..." : _modoActual.ToUpper())
                                </MudButton>
                            </MudCardActions>
                        </MudForm>
                    </MudStack>
                </div>
            </MudPopover>

        </MudPaper>

        <MudDataGrid T="Herramienta"
                     Items="@TiposHerramientas"
                     Filterable="true"
                     Sortable="true"
                     QuickFilter="@_quickFilter"
                     @bind-SelectedItem="HerramientaTipoSeleccionada">

            <ToolBarContent>
                <MudText Typo="Typo.h6">Lista de Tipo de Herramientas</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString"
                              Placeholder="Buscar..."
                              Adornment="Adornment.Start"
                              Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0" />
            </ToolBarContent>

            <Columns>
                <PropertyColumn Property="x => x.Id" Title="ID" Sortable="false" Filterable="false" />
                <PropertyColumn Property="x => x.Tipo" Title="Nombre" Sortable="false" Filterable="false" />

                <TemplateColumn Title="Acciones" Sortable="false" Filterable="false">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small" OnClick="@(() => AbrirModo("Editar",context.Item))"></MudIconButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => AbrirModo("Eliminar",context.Item))"></MudIconButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>

            <PagerContent>
                <MudDataGridPager T="Herramienta" 
                        RowsPerPageString="Filas por página:" 
                        InfoFormat="{first_item}-{last_item} de {all_items}" 
                        AllItemsText="Todos" />
            </PagerContent>

        </MudDataGrid>
    </MudItem>
</MudGrid>



@code {
    public string NombreHerramienta { get; set; }
    MudForm formulario;
    private bool _procesando = false;

    private string _searchString;
    private string _modoActual = "Crear";

    private bool _activo = true; 
    private Herramienta HerramientaTipoSeleccionada;
    private List<Herramienta> TiposHerramientas = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            TiposHerramientas = await Http.GetFromJsonAsync<List<Herramienta>>("api/herramienta") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al cargar datos: " + ex.Message, Severity.Error);
        }
    }

    protected async Task GuardarTipoHerramienta()
    {
        if (_procesando) return;

        await formulario.Validate();

        if (formulario.IsValid)
        {
            if (_modoActual == "Crear" && TiposHerramientas.Any(t => t.Tipo.Trim().Equals(NombreHerramienta.Trim(), StringComparison.OrdinalIgnoreCase)))
            {
                Snackbar.Add("Ese tipo de herramienta ya existe en el catálogo.", Severity.Warning);
                return;
            }
            _procesando = true;

            try
            {
                Herramienta herramienta = new Herramienta
                {
                    Id = _modoActual == "Editar" || _modoActual == "Eliminar" ? HerramientaTipoSeleccionada.Id : 0,
                    Tipo = NombreHerramienta,
                    FechaModificacion = DateTime.Today,
                    UsuarioModifico = 1,
                    Activo = HerramientaTipoSeleccionada == null ? true : _activo
                };

                HttpResponseMessage response = _modoActual switch
                {
                    "Crear" => await Http.PostAsJsonAsync("api/herramienta", herramienta),
                    "Editar" => await Http.PutAsJsonAsync($"api/herramienta/{herramienta.Id}", herramienta),
                    "Eliminar" => await Http.DeleteAsync($"api/herramienta/{herramienta.Id}"),
                    _ => throw new InvalidOperationException("Modo no válido")
                };


                if (response.IsSuccessStatusCode)
                {
                    await CargarDatos();
                    AbrirCrearTipo();
                    Snackbar.Add("Acción completada con éxito.", Severity.Success);
                }
            }
            finally
            {
                _procesando = false;
            }
        }
    }

    private void AbrirModo(string modo, Herramienta herramienta = null)
    {
        _modoActual = modo;
        AbrirCrearTipo();

        if (herramienta != null)
        {
            HerramientaTipoSeleccionada = herramienta;
            NombreHerramienta = herramienta.Tipo;
            _activo = herramienta.Activo ?? false;
        }
    }

   

    

    private bool _quickFilter(Herramienta x)
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

         if (x.Id.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
             return true;

        if (x.Tipo?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;



        return false;
    }

    public bool _abreCrearTipo;

    public void AbrirCrearTipo()
    {
        if (_abreCrearTipo)
        {
        _abreCrearTipo = false;
        limpiarFormulario();
        }
        else
            _abreCrearTipo = true;
    }
    public void limpiarFormulario()
    {
        HerramientaTipoSeleccionada = null;
        _modoActual = "Crear";
        NombreHerramienta = "";
        _activo = true;

    }

}
