@page "/registrar_lavado"

@using MudBlazor

<PageTitle>Registro Lavados</PageTitle>

<MudGrid Class="mt-5" Justify="Justify.Center">
    <MudItem xs="10" sm="7">
        <MudPaper Class="pa-4">

            <MudText Typo="Typo.h5" Class="mb-4">
                Registrar Lavado
            </MudText>

            <MudForm @ref="form" @bind-IsValid="success" @bind-Errors="errors">

                <MudSelect T="string"
                           Label="Lavador"
                           Variant="Variant.Outlined"
                           Required="true"
                           RequiredError="Campo obligatorio"
                           AnchorOrigin="Origin.BottomCenter"
                           @bind-Value="lavadorSeleccionado"
                           Class="mb-4">

                    @foreach (var lavador in _lavadores)
                    {
                        <MudSelectItem Value="@lavador">@lavador</MudSelectItem>
                    }

                </MudSelect>

                @if (!string.IsNullOrEmpty(lavadorSeleccionado))
                {
                    <MudSelect T="string"
                               Label="Tarea"
                               Variant="Variant.Outlined"
                               Required="true"
                               RequiredError="Campo obligatorio"
                               AnchorOrigin="Origin.BottomCenter"
                               @bind-Value="tareaSeleccionada"
                               Class="mb-4">

                        @foreach (var tarea in _tareas)
                        {
                            <MudSelectItem Value="@tarea">@tarea</MudSelectItem>
                        }

                    </MudSelect>

                    <MudDatePicker Label="Fecha"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   RequiredError="Campo obligatorio"
                                   @bind-Date="fechaSeleccionada"
                                   Class="mb-4" />

                    <MudCardActions>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                    Class="ml-auto"
                                   DisableElevation="true"
                                   OnClick="RegistrarLavado">
                            Registrar Lavado
                        </MudButton>
                    </MudCardActions>
                }

            </MudForm>

        </MudPaper>
    </MudItem>
</MudGrid>

@code {

    bool success;
    string[] errors = { };
    MudForm form;

    string lavadorSeleccionado;
    string tareaSeleccionada;
    DateTime? fechaSeleccionada;

    void RegistrarLavado()
    {
        form.Validate();
        if (form.IsValid)
        {
            form.Reset();
            lavadorSeleccionado = null;
            tareaSeleccionada = null;
            fechaSeleccionada = null;
        }
    }

    private readonly string[] _lavadores = { "Luis", "Jose", "Pepe" };

    private readonly string[] _tareas = { "Completo", "Interior", "Exterior" };
}
