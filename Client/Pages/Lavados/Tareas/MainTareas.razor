@page "/lavados/tareas"

@using MudBlazor
@using System.Globalization
@inject NavigationManager NavigationManager
@using System.Text.RegularExpressions


<PageTitle>Lista Tareas</PageTitle>

<MudGrid Class="mt-5" Justify="Justify.Center">
<MudItem xs="10">

        <MudText Typo="Typo.h3" Class="mb-4">
            Tareas
        </MudText>

        <MudPaper Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       Color="Color.Tertiary"
                       Class="mr-3"
                       OnClick="@AbrirCrearTarea">
                Registrar Tarea
            </MudButton>

            @*Overlay de Agregar Tarea*@
            <MudOverlay Visible="_abreCrearTarea" OnClick="@AbrirCrearTarea" DarkBackground="true" ZIndex="5" />

            @*Popover para registrar el prestamo*@
            <MudPopover Open="@_abreCrearTarea" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" RelativePanel="true">
                
                <MudText Typo="Typo.h5" Class="pa-4">
                    Registrar Tarea
                </MudText>
                
                <div style="width: 1000px; heigth: auto;" class="pa-5">
                    <MudStack Spacing="4">
                        <MudForm @ref="formulario" Spacing="9">
                                            <MudTextField T="string"
                                        Label="Tarea"
                                        Variant="Variant.Outlined"
                                        Required="true"
                                        RequiredError="Campo obligatorio"
                                        @bind-Value="nombreTarea"
                                        Class="mb-4" />

                            <MudTextField T="string"
                                        Label="Comisión"
                                        Variant="Variant.Outlined"
                                        Required="true"
                                        RequiredError="Campo obligatorio"
                                        @bind-Value="comision"
                                        Immediate="true"
                                        Validation="ValidarComision"
                                        Class="mb-4" />

                            <MudCardActions>
                                <MudButton Variant="Variant.Filled"
                                        Color="Color.Primary"
                                        DisableElevation="true"
                                        Class="ml-auto"
                                        OnClick="@AbrirCrearTarea">
                                    Registrar Tarea
                                </MudButton>
                            </MudCardActions>


                        </MudForm>
                    </MudStack>
                </div>
            </MudPopover>

        </MudPaper>

<MudDataGrid T="Tarea"
             Items="@tareas"
             Filterable="true"
             Sortable="true"
             QuickFilter="@_quickFilter">

    <ToolBarContent>
        <MudText Typo="Typo.h6">Lista de Tareas</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_searchString"
                      Placeholder="Buscar tarea..."
                      Adornment="Adornment.Start"
                      Immediate="true"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"
                      Class="mt-0" />
    </ToolBarContent>

    <Columns>
        <PropertyColumn Property="x => x.Id" Title="ID" Sortable="true" />
        <PropertyColumn Property="x => x.TareaTxt" Title="Tarea" />

        <TemplateColumn Title="Comisión">
            <CellTemplate>
                @context.Item.Comision.ToString("C", new CultureInfo("es-MX"))
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager T="Tarea" />
    </PagerContent>

</MudDataGrid>

<MudCardActions>
    <MudButton Variant="Variant.Filled"
               Color="Color.Secondary"
               Class="ml-auto"
               DisableElevation="true">
        Eliminar Tarea
    </MudButton>
</MudCardActions>

</MudItem>
</MudGrid>

@code {

    private string _searchString;

    private List<Tarea> tareas = new()
    {
        new Tarea { Id = 1, TareaTxt = "Lavado Completo", Comision = 70 },
        new Tarea { Id = 2, TareaTxt = "Lavado Exterior", Comision = 40 },
        new Tarea { Id = 3, TareaTxt = "Lavado Interior", Comision = 35 }
    };

    private bool _quickFilter(Tarea x)
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.TareaTxt?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;

        if (x.Comision.ToString().Contains(_searchString))
            return true;

        return false;
    }

    class Tarea
    {
        public int Id { get; set; }
        public string TareaTxt { get; set; }
        public double Comision { get; set; }
    }

    private void NavegarARegistrarTarea()
    {
        NavigationManager.NavigateTo("/lavados/tareas/registrar_tarea");
    }

    private void NavegarAEliminarLavado()
    {
        NavigationManager.NavigateTo("/lavados/tareas/eliminar_tarea");
    }


    MudForm formulario;
    public bool _abreCrearTarea;

    public void AbrirCrearTarea()
    {
        if (_abreCrearTarea)
            _abreCrearTarea = false;
        else
            _abreCrearTarea = true;
    }

    bool success;
    string[] errors = { };
    MudForm form;

    string nombreTarea;
    string comision;

    void TryRegistrarTarea()
    {
        form.Validate();
        if (form.IsValid)
        {
            form.Reset();
            nombreTarea = null;
            comision = null;
        }
    }

    private string ValidarComision(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "Campo obligatorio";

        // Only numbers with exactly two decimals
        var regex = new Regex(@"^\d+(\.\d{2})$");

        if (!regex.IsMatch(value))
            return "Debe ser un número con exactamente 2 decimales (ej. 100.00)";

        return null;
    }



}
