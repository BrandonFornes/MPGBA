@page "/lavados/nominas"
@using MudBlazor
@inject NavigationManager NavigationManager

<PageTitle>Historial Lavados</PageTitle>

<MudGrid Class="mt-5" Justify="Justify.Center">
<MudItem xs="10">

        <MudText Typo="Typo.h3" Class="mb-4">
            Lavados
        </MudText>

        <MudPaper Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       Color="Color.Tertiary"
                       Class="mr-3"
                       OnClick="@AbrirCrearLavado">
                Registrar Lavado
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       Color="Color.Info"
                       OnClick="@AbrirGenerarNomina">
                Generar Nómina
            </MudButton>

            @*Overlay de Prestamo*@
            <MudOverlay Visible="_abreCrearLavado" OnClick="@AbrirCrearLavado" DarkBackground="true" ZIndex="5" />

            @*Overlay de Devolucion*@
            <MudOverlay Visible="_abreGenerarNomina" OnClick="@AbrirGenerarNomina" DarkBackground="true" ZIndex="5" />

            <MudOverlay Visible="_abreEliminarLavado" OnClick="@AbrirEliminarLavado" DarkBackground="true" ZIndex="5" />


            @*Popover para devolver el prestamo*@
            <MudPopover Open="@_abreCrearLavado" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" RelativePanel="true">
                
                @* Usamos un div o Paper con un ancho definido (ej. 350px) *@
                <MudText Typo="Typo.h5" Class="pa-4">
                    Registrar Lavado
                </MudText>
                
                <div style="width: 1000px; heigth: auto;" class="pa-5">
                    <MudStack Spacing="4">
                        <MudForm @ref="form" Spacing="9">
                            <MudSelect T="string"
                                    Label="Lavador"
                                    Variant="Variant.Outlined"
                                    Required="true"
                                    RequiredError="Campo obligatorio"
                                    AnchorOrigin="Origin.BottomCenter"
                                    @bind-Value="lavadorSeleccionado"
                                    Class="mb-4">

                                @foreach (var lavador in _lavadores)
                                {
                                    <MudSelectItem Value="@lavador">@lavador</MudSelectItem>
                                }

                            </MudSelect>

                            @if (!string.IsNullOrEmpty(lavadorSeleccionado))
                            {
                                <MudSelect T="string"
                                        Label="Tarea"
                                        Variant="Variant.Outlined"
                                        Required="true"
                                        RequiredError="Campo obligatorio"
                                        AnchorOrigin="Origin.BottomCenter"
                                        @bind-Value="tareaSeleccionada"
                                        Class="mb-4">

                                    @foreach (var tarea in _tareas)
                                    {
                                        <MudSelectItem Value="@tarea">@tarea</MudSelectItem>
                                    }

                                </MudSelect>

                                <MudSelect T="string"
                                    Label="Selecciona Vehículo"
                                    @bind-Value="vehiculoSeleccionado"
                                    Variant="Variant.Outlined"
                                    Required="true"
                                    RequiredError="Campo Obligatorio"
                                    Searchable="true"
                                    AnchorOrigin="Origin.BottomCenter"
                                    Class="mb-4">

                                @foreach (var vehiculo in _vehiculos)
                                {
                                    <MudSelectItem Value="@vehiculo">
                                        @vehiculo
                                    </MudSelectItem>
                                }

                            </MudSelect>

                                <MudDatePicker Label="Fecha"
                                            Variant="Variant.Outlined"
                                            Required="true"
                                            RequiredError="Campo obligatorio"
                                            @bind-Date="fechaSeleccionada"
                                            Class="mb-4" />

                                <MudCardActions>
                                    <MudButton Variant="Variant.Filled"
                                            Color="Color.Primary"
                                                Class="ml-auto"
                                            DisableElevation="true"
                                            OnClick="@AbrirCrearLavado">
                                        Registrar Lavado
                                    </MudButton>
                                </MudCardActions>
                            }

                        </MudForm>
                    </MudStack>
                </div>
            </MudPopover>


            <MudPopover Open="@_abreGenerarNomina" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" RelativePanel="true">
                
                @* Usamos un div o Paper con un ancho definido (ej. 350px) *@
                <MudText Typo="Typo.h5" Class="pa-4">
                    Generar Nomina de Lavador
                </MudText>
                
                <div style="width: 1000px; heigth: auto;" class="pa-5">
                    <MudStack Spacing="4">
                        <MudForm @ref="form2" Spacing="9">
                            <MudSelect T="string" Label="Lavador" AnchorOrigin="Origin.BottomCenter">
                                <MudSelectItem Value="@("Luis")" />
                                <MudSelectItem Value="@("Jose")" />
                                <MudSelectItem Value="@("Pepe")" />
                            </MudSelect>

                        
                        </MudForm>
                    </MudStack>

                    <MudPaper Class="pa-4 mt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" DisableElevation="true" OnClick="ToggleComponentes">Generar Nomina </MudButton>            
                    </MudPaper>

                    @if (mostrar)
                    {
                        <MudPaper Class="pa-4 mt-4">
                            <MudSimpleTable Hover="true" Dense="true" FixedHeader="@fixedheader" Style="@(fixedheader?"height:300px;":"")">
                                <thead>
                                    <tr>
                                        @foreach (var h in headings)
                                        {
                                            <th>@h</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in rows)
                                    {
                                        <tr>
                                            @foreach (var x in row.Split())
                                            {
                                                <td>@x</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudPaper>
                        <MudPaper Class="pa-4 mt-4">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" DisableElevation="true" OnClick="@(() => form.Reset())">Generar Archivo (.csv) </MudButton>            
                        </MudPaper>
                    }

                </div>
            </MudPopover>

            <MudPopover Open="@_abreEliminarLavado" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" RelativePanel="true">
                
                @* Usamos un div o Paper con un ancho definido (ej. 350px) *@
                <MudText Typo="Typo.h5" Class="pa-4">
                    Eliminar Lavado
                </MudText>
                
                <div style="width: 1000px; heigth: auto;" class="pa-5">
                    <MudStack Spacing="4">
                        <MudForm @ref="form2" Spacing="9">
                            <MudTextField T="string" Label="Id Lavado" />

                            <MudPaper Class="pa-4 mt-4">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" DisableElevation="true" OnClick="@AbrirEliminarLavado">Eliminar Lavado</MudButton>            
                            </MudPaper>
                        
                        </MudForm>
                    </MudStack>

                </div>
            </MudPopover>



        </MudPaper>

<MudDataGrid T="Lavado"
             Items="@Lavados"
             Filterable="true"
             Sortable="true"
             QuickFilter="@_quickFilter">

    <ToolBarContent>
        <MudText Typo="Typo.h6">Historial de Lavados</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_searchString"
                      Placeholder="Buscar por lavador o tarea..."
                      Adornment="Adornment.Start"
                      Immediate="true"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"
                      Class="mt-0" />
    </ToolBarContent>

    <Columns>
        <PropertyColumn Property="x => x.Id" Title="ID" Sortable="true" />
        <PropertyColumn Property="x => x.Lavador" Title="Lavador" />
        <PropertyColumn Property="x => x.Tarea" Title="Tarea" />
        <PropertyColumn Property="x => x.Vehiculo" Title="Vehiculo" />
        <PropertyColumn Property="x => x.Fecha"
                        Title="Fecha"
                        Format="dd/MM/yyyy" />
    </Columns>

    <PagerContent>
        <MudDataGridPager T="Lavado" />
    </PagerContent>

</MudDataGrid>

<MudCardActions>
    <MudButton Variant="Variant.Filled"
               Color="Color.Secondary"
               Class="ml-auto"
               DisableElevation="true">
        Eliminar Registro
    </MudButton>
</MudCardActions>

</MudItem>
</MudGrid>

@code {

    private string _searchString;
    private List<Lavado> Lavados = new();

    protected override void OnInitialized()
    {
        Lavados.AddRange(new[]
        {
            new Lavado { Id = 1, Lavador = "Jose Martinez", Tarea = "Lavado Interior", Vehiculo = "MZD-5544-Y", Fecha = DateTime.Today.AddDays(-1) },
            new Lavado { Id = 2, Lavador = "Luis Suarez", Tarea = "Lavado Exterior", Vehiculo = "MZD-5544-Y", Fecha = DateTime.Today.AddDays(-2) },
            new Lavado { Id = 3, Lavador = "Leonardo Govea", Tarea = "Lavado Exterior", Vehiculo = "MZD-5544-Y", Fecha = DateTime.Today.AddDays(-2) },
            new Lavado { Id = 4, Lavador = "Mario Paez", Tarea = "Lavado Completo", Vehiculo = "MZD-5544-Y", Fecha = DateTime.Today.AddDays(-3) },
            new Lavado { Id = 5, Lavador = "Jose Martinez", Tarea = "Lavado Completo", Vehiculo = "MZD-5544-Y", Fecha = DateTime.Today.AddDays(-3) },
            new Lavado { Id = 6, Lavador = "Joshua Perez", Tarea = "Lavado Exterior", Vehiculo = "MZD-5544-Y", Fecha = DateTime.Today.AddDays(-3) }
        });
    }

    private bool _quickFilter(Lavado x)
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.Lavador?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;

        if (x.Tarea?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;

        if (x.Fecha.ToString("dd/MM/yyyy").Contains(_searchString))
            return true;

        return false;
    }

    private void NavegarARegistrarLavado()
    {
        NavigationManager.NavigateTo("/lavados/nominas/registrar_lavado");
    }

    private void NavegarAGenerarNomina()
    {
        NavigationManager.NavigateTo("/lavados/nominas/generar_nomina");
