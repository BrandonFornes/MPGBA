@page "/lavados/nominas"
@using ClosedXML.Excel
@using System.IO
@inject IJSRuntime JS
@using MudBlazor
@using System.Globalization
@using AdminHerramientas.Shared.Models
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Historial y Nóminas</PageTitle>

<MudGrid Class="mt-5" Justify="Justify.Center">
    <MudItem xs="10">
        <MudText Typo="Typo.h3" Class="mb-4">Registro de Lavados</MudText>

        <MudPaper Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled" Size="Size.Large" Color="Color.Tertiary" Class="mr-3" OnClick="@AbrirCrearLavado">
                Registrar Lavado
            </MudButton>

            <MudButton Variant="Variant.Filled" Size="Size.Large" Color="Color.Info" OnClick="@AbrirGenerarNomina">
                Generar Nómina
            </MudButton>

            @* --- OVERLAYS --- *@
            <MudOverlay Visible="_abreCrearLavado" OnClick="@AbrirCrearLavado" DarkBackground="true" ZIndex="5" />
            <MudOverlay Visible="_abreGenerarNomina" OnClick="@AbrirGenerarNomina" DarkBackground="true" ZIndex="5" />

            @* --- POPOVER: REGISTRAR/EDITAR --- *@
            <MudPopover Open="@_abreCrearLavado" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" RelativePanel="true">
                <MudText Typo="Typo.h5" Class="pa-4">@(selectedItem == null ? "Registrar Nuevo Lavado" : "Editar Registro #" + selectedItem.Id)</MudText>
                <div style="width: 600px; height: auto;" class="pa-5">
                    <MudForm @ref="formRegistro">

                        <MudAutocomplete T="Operario" 
                            Label="Seleccionar Lavador" 
                            @bind-Value="operarioSeleccionado" 
                            SearchFunc="@SearchLavadores"
                            ToStringFunc="@(e => e == null ? null : e.Nombre)"
                            Variant="Variant.Outlined" 
                            Required="true" 
                            Class="mb-4"
                            ResetValueOnEmptyText="true"
                            CoerceText="false" 
                            CoerceValue="false" />
                        
                        <MudAutocomplete T="Tarea" 
                            Label="Tipo de Tarea" 
                            @bind-Value="tareaSeleccionada" 
                            SearchFunc="@SearchTareas"
                            ToStringFunc="@(e => e == null ? null : e.NombreTarea)"
                            Variant="Variant.Outlined" 
                            Required="true" 
                            Class="mb-4"
                            ResetValueOnEmptyText="true"
                            CoerceText="false" 
                            CoerceValue="false" />
                        


                        

                        <MudAutocomplete T="Vehiculo" 
                                Label="Vehículo" 
                                @bind-Value="vehiculoSeleccionado" 
                                SearchFunc="@SearchVehiculos"
                                ToStringFunc="@(v => v == null ? null : $"{v.Bastidor} - {v.DesMarca} {v.DesModelo}")"
                                Variant="Variant.Outlined" 
                                Required="true" 
                                Class="mb-4"
                                ResetValueOnEmptyText="true"
                                CoerceText="false" 
                                CoerceValue="false" />

                        <MudDatePicker Label="Fecha del Servicio" @bind-Date="fechaSeleccionada" Variant="Variant.Outlined" Required="true" Class="mb-4" />

                        <MudCardActions>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" OnClick="GuardarLavado" Disabled="@_procesando">
                                @( _procesando ? "Procesando..." : (selectedItem == null ? "Registrar" : "Actualizar" ) )
                            </MudButton>
                        </MudCardActions>
                    </MudForm>
                </div>
            </MudPopover>

            @* --- POPOVER: GENERAR NÓMINA --- *@
            <MudPopover Open="@_abreGenerarNomina" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" RelativePanel="true">
                <MudText Typo="Typo.h5" Class="pa-4">Cálculo de Nómina</MudText>
                <div style="width: 800px; height: auto;" class="pa-5">
                    <MudStack Spacing="4">
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudAutocomplete T="Operario" 
                                    Label="Seleccionar Operario" 
                                    @bind-Value="operarioFiltroNomina" 
                                    SearchFunc="@SearchLavadores"
                                    ToStringFunc="@(e => e == null ? null : e.Nombre)"
                                    Variant="Variant.Outlined" 
                                    Required="true" 
                                    Class="mb-4"
                                    ResetValueOnEmptyText="true"
                                    CoerceText="false" 
                                    CoerceValue="false" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudDateRangePicker Label="Rango de Fechas" @bind-DateRange="_dateRange" Variant="Variant.Outlined" />
                            </MudItem>
                        </MudGrid>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="FiltrarNomina" StartIcon="@Icons.Material.Filled.Calculate">
                            Ver Detalle de Pagos
                        </MudButton>

                        @if (mostrarNomina)
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-4">
                                <MudText Typo="Typo.h6">Resumen de Pagos</MudText>
                                <MudButton Variant="Variant.Filled" 
                                        Color="Color.Success" 
                                        StartIcon="@Icons.Material.Filled.Download"
                                        OnClick="ExportarNominaExcel">
                                    Descargar Excel
                                </MudButton>
                            </MudStack>
                            <MudPaper Class="pa-4 mt-4" Elevation="0">
                                <MudTable Items="@nominaFiltrada" Dense="true" Hover="true">
                                    <HeaderContent>
                                        <MudTh>Fecha</MudTh>
                                        <MudTh>Tarea</MudTh>
                                        <MudTh>Vehículo</MudTh>
                                        <MudTh>Comisión</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.Fecha.ToString("dd/MM/yyyy")</MudTd>
                                        <MudTd>@ObtenerNombreTarea(context.FkIdTarea)</MudTd>
                                        <MudTd>@ObtenerNombreVehiculo(context.FkBastidor)</MudTd>
                                        <MudTd>@context.ComisionRegistro.ToString("C", _mexico)</MudTd>
                                    </RowTemplate>
                                    <FooterContent>
                                        <MudTFootRow>
                                            <MudTd colspan="3" Style="text-align:right"><strong>Total a Pagar:</strong></MudTd>
                                            <MudTd><strong>@totalNomina.ToString("C", _mexico)</strong></MudTd>
                                        </MudTFootRow>
                                    </FooterContent>
                                </MudTable>
                            </MudPaper>
                        }
                    </MudStack>
                </div>
            </MudPopover>
        </MudPaper>

        <MudDataGrid T="RegistrosLavado" Items="@listaHistorial" Filterable="true" Sortable="true" QuickFilter="@_quickFilter">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Historial de Servicios</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString" Placeholder="Buscar..." 
                                Adornment="Adornment.Start" Immediate="true" AdornmentIcon="@Icons.Material.Filled.Search" />
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.Id" Title="Folio" Sortable="false" Filterable="false" />
                <TemplateColumn Title="Operario" Sortable="false" Filterable="false">
                    <CellTemplate>@ObtenerNombreOperario(context.Item.FkCodigoOperario)</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Tarea" Sortable="false" Filterable="false" >
                    <CellTemplate>@ObtenerNombreTarea(context.Item.FkIdTarea)</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Vehiculo" Sortable="false" Filterable="false" >
                    <CellTemplate>@ObtenerNombreVehiculo(context.Item.FkBastidor)</CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Fecha" Title="Fecha" Format="dd/MM/yyyy" Sortable="false" Filterable="false" />
                <PropertyColumn Property="x => x.ComisionRegistro" Title="Pago" Format="C2" Sortable="false" Filterable="false" />
                <TemplateColumn Title="Acciones" Sortable="false" Filterable="false" >
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small" OnClick="@(() => EditarRegistro(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="RegistrosLavado" 
                        RowsPerPageString="Filas por página:" 
                        InfoFormat="{first_item}-{last_item} de {all_items}" 
                        AllItemsText="Todos" />
            </PagerContent>
        </MudDataGrid>
    </MudItem>
</MudGrid>

@code {
    private CultureInfo _mexico = new CultureInfo("es-MX");
    private string _searchString = "";
    private MudForm formRegistro;
    
    private List<RegistrosLavado> listaHistorial = new();
    private List<Operario> listaOperarios = new();
    private List<Tarea> listaTareas = new();
    private List<Vehiculo> listaVehiculos = new();

    private List<Operario> OperariosLavado => listaOperarios
        .Where(o => o.Seccion != null && o.Seccion.Contains("Lavado", StringComparison.OrdinalIgnoreCase))
        .ToList();

    private List<Operario> OperariosParaNomina => OperariosLavado
        .Where(o => listaHistorial.Any(h => h.FkCodigoOperario == o.Codigo))
        .ToList();

    private RegistrosLavado? selectedItem;
    private Operario operarioSeleccionado;
    private Tarea tareaSeleccionada;
    private Vehiculo vehiculoSeleccionado;
    private DateTime? fechaSeleccionada = DateTime.Today;

    private bool _abreCrearLavado, _abreGenerarNomina, mostrarNomina;
    private Operario operarioFiltroNomina;
    private List<RegistrosLavado> nominaFiltrada = new();
    private decimal totalNomina;

    private MudDateRangePicker _picker;
    private DateRange _dateRange = new DateRange(DateTime.Now.Date.AddDays(-15), DateTime.Now.Date);

    private bool _procesando = false;

    protected override async Task OnInitializedAsync() => await CargarTodosLosDatos();

    private async Task CargarTodosLosDatos() 
    {
        try {
            var t1 = Http.GetFromJsonAsync<List<RegistrosLavado>>("api/registroslavados");
            var t2 = Http.GetFromJsonAsync<List<Operario>>("api/operario");
            var t3 = Http.GetFromJsonAsync<List<Tarea>>("api/tareas");
            var t4 = Http.GetFromJsonAsync<List<Vehiculo>>("api/vehiculos");
            await Task.WhenAll(t1, t2, t3, t4);
            listaHistorial = await t1 ?? new();
            listaOperarios = await t2 ?? new();
            listaTareas = await t3 ?? new();
            listaVehiculos = await t4 ?? new();
        } catch (Exception ex) { 
            Snackbar.Add("Error al cargar datos: " + ex.Message, Severity.Error);
        }
    }

    private async Task GuardarLavado() 
    {
        if (_procesando) return;


        await formRegistro.Validate();
        if (formRegistro.IsValid) {
            _procesando = true;
            try 
            {
                            
                var registro = new RegistrosLavado {
                    Id = selectedItem?.Id ?? 0,
                    FkCodigoOperario = operarioSeleccionado.Codigo,
                    FkIdTarea = tareaSeleccionada.Id,
                    FkBastidor = vehiculoSeleccionado?.Bastidor,
                    Fecha = fechaSeleccionada ?? DateTime.Now,
                    ComisionRegistro = tareaSeleccionada.ComisionTarea,
                    FechaModificacion = DateTime.Now,
                    UsuarioModifico = 1,
                    Activo = true
                };

                var res = (selectedItem == null) 
                    ? await Http.PostAsJsonAsync("api/registroslavados", registro) 
                    : await Http.PutAsJsonAsync($"api/registroslavados/{registro.Id}", registro);

                if (res.IsSuccessStatusCode) {
                    Snackbar.Add(selectedItem == null ? "Registrado" : "Actualizado", Severity.Success);
                    await CargarTodosLosDatos();
                    _abreCrearLavado = false;
                }
                else
                {
                    Snackbar.Add("Error al procesar la solicitud", Severity.Error);
                }
            }
            finally {
                _procesando = false;
            }

            
        }
    }

    private void FiltrarNomina() 
    {
        if (operarioFiltroNomina == null || _dateRange.Start == null || _dateRange.End == null) 
        {
            Snackbar.Add("Selecciona un operario y un rango de fechas", Severity.Warning);
            return;
        }

        nominaFiltrada = listaHistorial
            .Where(x => x.FkCodigoOperario == operarioFiltroNomina.Codigo &&
                        x.Fecha.Date >= _dateRange.Start.Value.Date &&
                        x.Fecha.Date <= _dateRange.End.Value.Date)
            .ToList();

        totalNomina = nominaFiltrada.Sum(x => x.ComisionRegistro);
        mostrarNomina = true;
    }

    public void AbrirCrearLavado() {
        if (!_abreCrearLavado) LimpiarForm();
        _abreCrearLavado = !_abreCrearLavado;
    }

    public void AbrirGenerarNomina() {
        if (_abreGenerarNomina) LimpiarDatosNomina();
        _abreGenerarNomina = !_abreGenerarNomina;
    }

    private void LimpiarForm() {
        selectedItem = null; operarioSeleccionado = null; tareaSeleccionada = null;
        vehiculoSeleccionado = null; fechaSeleccionada = DateTime.Today;
    }

    private void LimpiarDatosNomina() {
        operarioFiltroNomina = null;  _dateRange = new DateRange(DateTime.Now.Date.AddDays(-15), DateTime.Now.Date); mostrarNomina = false; totalNomina = 0;
    }

    private void EditarRegistro(RegistrosLavado registro) {
        selectedItem = registro;
        operarioSeleccionado = listaOperarios.FirstOrDefault(o => o.Codigo == registro.FkCodigoOperario);
        tareaSeleccionada = listaTareas.FirstOrDefault(t => t.Id == registro.FkIdTarea);
        vehiculoSeleccionado = listaVehiculos.FirstOrDefault(v => v.Bastidor == registro.FkBastidor);
        fechaSeleccionada = registro.Fecha;
        _abreCrearLavado = true;
    }

    private async Task ExportarNominaExcel()
    {
        if (!nominaFiltrada.Any()) return;

        using (var workbook = new XLWorkbook())
        {
            var worksheet = workbook.Worksheets.Add("Nomina");

            // --- ENCABEZADOS ---
            worksheet.Cell(1, 1).Value = "Fecha";
            worksheet.Cell(1, 2).Value = "Tarea";
            worksheet.Cell(1, 3).Value = "Vehículo";
            worksheet.Cell(1, 4).Value = "Comisión";

            // Estilo encabezado
            var header = worksheet.Range("A1:D1");
            header.Style.Font.Bold = true;
            header.Style.Fill.BackgroundColor = XLColor.LightGray;

            // --- DATOS ---
            int fila = 2;
            foreach (var registro in nominaFiltrada)
            {
                worksheet.Cell(fila, 1).Value = registro.Fecha.ToString("dd/MM/yyyy");
                worksheet.Cell(fila, 2).Value = ObtenerNombreTarea(registro.FkIdTarea);
                worksheet.Cell(fila, 3).Value = ObtenerNombreVehiculo(registro.FkBastidor);
                worksheet.Cell(fila, 4).Value = registro.ComisionRegistro;
                worksheet.Cell(fila, 4).Style.NumberFormat.Format = "$ #,##0.00";
                fila++;
            }

            // --- TOTAL ---
            worksheet.Cell(fila, 3).Value = "TOTAL A PAGAR:";
            worksheet.Cell(fila, 3).Style.Font.Bold = true;
            worksheet.Cell(fila, 4).Value = totalNomina;
            worksheet.Cell(fila, 4).Style.Font.Bold = true;

            worksheet.Columns().AdjustToContents(); 

            // --- DESCARGA ---
            using (var stream = new MemoryStream())
            {
                workbook.SaveAs(stream);
                var content = stream.ToArray();
                using var streamRef = new DotNetStreamReference(new MemoryStream(content));
                
                string fechaInicio = _dateRange.Start?.ToString("yyyyMMdd");
                string fechaFin = _dateRange.End?.ToString("yyyyMMdd");
                string nombreArchivo = $"Nomina_{operarioFiltroNomina.Nombre}_{fechaInicio}_a_{fechaFin}.xlsx";
                
                await JS.InvokeVoidAsync("downloadFileFromStream", nombreArchivo, streamRef);
            }
        }
    }

    private bool _quickFilter(RegistrosLavado x)
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        
        string lavador = ObtenerNombreOperario(x.FkCodigoOperario);
        string tarea = ObtenerNombreTarea(x.FkIdTarea);
        string vehiculo = ObtenerNombreVehiculo(x.FkBastidor);
        
        string fechaString = x.Fecha.ToString("dd/MM/yyyy");

        return x.Id.ToString().Contains(_searchString) ||
            lavador.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
            tarea.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
            vehiculo.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
            fechaString.Contains(_searchString); 
    }

    private async Task<IEnumerable<Operario>> SearchLavadores(string value)
    {
        if (string.IsNullOrEmpty(value))
            return OperariosLavado;

        return OperariosLavado
            .Where(x => x.Nombre.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<Tarea>> SearchTareas(string value)
    {
        if (string.IsNullOrEmpty(value))
            return listaTareas;

        return listaTareas
            .Where(x => x.NombreTarea.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<Vehiculo>> SearchVehiculos(string value)
    {
        if (string.IsNullOrEmpty(value))
            return listaVehiculos;

        return listaVehiculos.Where(x => 
            x.Bastidor.Contains(value, StringComparison.InvariantCultureIgnoreCase) ||
            x.Idv.ToString().Contains(value, StringComparison.InvariantCultureIgnoreCase) ||
            x.DesMarca.Contains(value, StringComparison.InvariantCultureIgnoreCase) ||
            x.DesModelo.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private string ObtenerNombreOperario(string codigo) => listaOperarios.FirstOrDefault(o => o.Codigo == codigo)?.Nombre ?? codigo;
    private string ObtenerNombreTarea(int id) => listaTareas.FirstOrDefault(t => t.Id == id)?.NombreTarea ?? $"ID: {id}";
    private string ObtenerNombreVehiculo(string bastidor) => listaVehiculos.FirstOrDefault(v => v.Bastidor == bastidor)?.DesModelo ?? "N/A";
}