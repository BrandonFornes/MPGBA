@page "/lavados/nominas"
@using MudBlazor
@using System.Globalization
@using AdminHerramientas.Shared.Models
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Historial y Nóminas</PageTitle>

<MudGrid Class="mt-5" Justify="Justify.Center">
    <MudItem xs="10">
        <MudText Typo="Typo.h3" Class="mb-4">Registro de Lavados</MudText>

        <MudPaper Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled" Size="Size.Large" Color="Color.Tertiary" Class="mr-3" OnClick="@AbrirCrearLavado">
                Registrar Lavado
            </MudButton>

            <MudButton Variant="Variant.Filled" Size="Size.Large" Color="Color.Info" OnClick="@AbrirGenerarNomina">
                Generar Nómina
            </MudButton>

            @* --- OVERLAYS --- *@
            <MudOverlay Visible="_abreCrearLavado" OnClick="@AbrirCrearLavado" DarkBackground="true" ZIndex="5" />
            <MudOverlay Visible="_abreGenerarNomina" OnClick="@AbrirGenerarNomina" DarkBackground="true" ZIndex="5" />

            @* --- POPOVER: REGISTRAR LAVADO --- *@
            <MudPopover Open="@_abreCrearLavado" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" RelativePanel="true">
                <MudText Typo="Typo.h5" Class="pa-4">Registrar Nuevo Lavado</MudText>
                <div style="width: 600px; height: auto;" class="pa-5">
                    <MudForm @ref="formRegistro">
                        <MudSelect T="Operario" Label="Seleccionar Lavador" @bind-Value="operarioSeleccionado" Variant="Variant.Outlined" Required="true" Class="mb-4">
                            @foreach (var op in listaOperarios)
                            {
                                <MudSelectItem Value="@op">@op.Nombre</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="Tarea" Label="Tipo de Tarea" @bind-Value="tareaSeleccionada" Variant="Variant.Outlined" Required="true" Class="mb-4">
                            @foreach (var t in listaTareas)
                            {
                                <MudSelectItem Value="@t">@t.NombreTarea ($@t.ComisionTarea)</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="Vehiculo" Label="Vehículo" @bind-Value="vehiculoSeleccionado" Variant="Variant.Outlined" Searchable="true" Required="true" Class="mb-4">
                            @foreach (var v in listaVehiculos)
                            {
                                <MudSelectItem Value="@v">@v.Idv - @v.DesMarca @v.DesModelo</MudSelectItem>
                            }
                        </MudSelect>

                        <MudDatePicker Label="Fecha del Servicio" @bind-Date="fechaSeleccionada" Variant="Variant.Outlined" Required="true" Class="mb-4" />

                        <MudCardActions>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" OnClick="GuardarNuevoLavado">Registrar</MudButton>
                        </MudCardActions>
                    </MudForm>
                </div>
            </MudPopover>

            @* --- POPOVER: GENERAR NÓMINA --- *@
            <MudPopover Open="@_abreGenerarNomina" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" RelativePanel="true">
                <MudText Typo="Typo.h5" Class="pa-4">Cálculo de Nómina</MudText>
                <div style="width: 800px; height: auto;" class="pa-5">
                    <MudSelect T="Operario" Label="Seleccionar Operario" @bind-Value="operarioFiltroNomina" Variant="Variant.Outlined" Class="mb-4">
                        @foreach (var op in listaOperarios)
                        {
                            <MudSelectItem Value="@op">@op.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                    
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="FiltrarNomina">Ver Detalle de Pagos</MudButton>

                    @if (mostrarNomina)
                    {
                        <MudPaper Class="pa-4 mt-4" Elevation="0">
                            <MudTable Items="@nominaFiltrada" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                                <HeaderContent>
                                    <MudTh>Fecha</MudTh>
                                    <MudTh>Tarea</MudTh>
                                    <MudTh>Vehículo</MudTh>
                                    <MudTh>Comisión</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.Fecha.ToString("dd/MM/yyyy")</MudTd>
                                    <MudTd>@ObtenerNombreTarea(context.FkIdTarea)</MudTd>
                                    <MudTd>@context.FkCodigoOperario</MudTd> @* Aquí podrías poner el ID del vehículo *@
                                    <MudTd>@context.ComisionRegistro.ToString("C", _mexico)</MudTd>
                                </RowTemplate>
                                <FooterContent>
                                    <MudTFootRow>
                                        <MudTd colspan="3" Style="text-align:right"><strong>Total a Pagar:</strong></MudTd>
                                        <MudTd><strong>@totalNomina.ToString("C", _mexico)</strong></MudTd>
                                    </MudTFootRow>
                                </FooterContent>
                            </MudTable>
                        </MudPaper>
                    }
                </div>
            </MudPopover>
        </MudPaper>

        @* --- TABLA PRINCIPAL DE HISTORIAL --- *@
        <MudDataGrid T="RegistrosLavado" Items="@listaHistorial" Filterable="true" Sortable="true">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Historial General de Lavados</MudText>
                <MudSpacer />
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="x => x.Id" Title="Folio" />
                <TemplateColumn Title="Operario">
                    <CellTemplate>@ObtenerNombreOperario(context.Item.FkCodigoOperario)</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Tarea">
                    <CellTemplate>@ObtenerNombreTarea(context.Item.FkIdTarea)</CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Fecha" Title="Fecha" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.ComisionRegistro" Title="Pago" Format="C2" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="RegistrosLavado" />
            </PagerContent>
        </MudDataGrid>
    </MudItem>
</MudGrid>

@code {
    private CultureInfo _mexico = new CultureInfo("es-MX");
    private MudForm formRegistro;
    
    // Listas de datos reales
    private List<RegistrosLavado> listaHistorial = new();
    private List<Operario> listaOperarios = new();
    private List<Tarea> listaTareas = new();
    private List<Vehiculo> listaVehiculos = new();
    
    // Variables de selección
    private Operario operarioSeleccionado;
    private Tarea tareaSeleccionada;
    private Vehiculo vehiculoSeleccionado;
    private DateTime? fechaSeleccionada = DateTime.Today;

    // Variables de Nómina
    private Operario operarioFiltroNomina;
    private List<RegistrosLavado> nominaFiltrada = new();
    private decimal totalNomina = 0;
    private bool mostrarNomina = false;

    private bool _abreCrearLavado;
    private bool _abreGenerarNomina;

    protected override async Task OnInitializedAsync()
    {
        await CargarTodosLosDatos();
    }

    private async Task CargarTodosLosDatos()
    {
        try 
        {
            // Cargamos todo en paralelo para que sea más rápido
            var t1 = Http.GetFromJsonAsync<List<RegistrosLavado>>("api/registroslavados");
            var t2 = Http.GetFromJsonAsync<List<Operario>>("api/operario");
            var t3 = Http.GetFromJsonAsync<List<Tarea>>("api/tareas");
            var t4 = Http.GetFromJsonAsync<List<Vehiculo>>("api/vehiculos");

            await Task.WhenAll(t1, t2, t3, t4);

            listaHistorial = await t1 ?? new();
            listaOperarios = await t2 ?? new();
            listaTareas = await t3 ?? new();
            listaVehiculos = await t4 ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error de conexión: " + ex.Message, Severity.Error);
        }
    }

    private async Task GuardarNuevoLavado()
    {
        await formRegistro.Validate();
        if (formRegistro.IsValid)
        {
            var nuevo = new RegistrosLavado
            {
                FkCodigoOperario = operarioSeleccionado.Codigo,
                FkIdTarea = tareaSeleccionada.Id,
                Fecha = fechaSeleccionada ?? DateTime.Now,
                ComisionRegistro = tareaSeleccionada.ComisionTarea, // Guardamos la comisión actual
                FechaModificacion = DateTime.Now,
                UsuarioModifico = 1,
                Activo = true
            };

            var res = await Http.PostAsJsonAsync("api/registroslavados", nuevo);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("Lavado registrado correctamente", Severity.Success);
                _abreCrearLavado = false;
                await CargarTodosLosDatos();
                LimpiarForm();
            }
        }
    }

    private void FiltrarNomina()
    {
        if (operarioFiltroNomina == null) return;
        
        nominaFiltrada = listaHistorial
            .Where(x => x.FkCodigoOperario == operarioFiltroNomina.Codigo)
            .ToList();
        
        totalNomina = nominaFiltrada.Sum(x => x.ComisionRegistro);
        mostrarNomina = true;
    }

    // Helpers para mostrar nombres en lugar de IDs en la tabla
    private string ObtenerNombreOperario(string codigo) => listaOperarios.FirstOrDefault(o => o.Codigo == codigo)?.Nombre ?? codigo;
    private string ObtenerNombreTarea(int id) => listaTareas.FirstOrDefault(t => t.Id == id)?.NombreTarea ?? $"ID: {id}";

    private void LimpiarForm()
    {
        operarioSeleccionado = null;
        tareaSeleccionada = null;
        vehiculoSeleccionado = null;
        fechaSeleccionada = DateTime.Today;
    }

    public void AbrirCrearLavado() => _abreCrearLavado = !_abreCrearLavado;
    public void AbrirGenerarNomina() => _abreGenerarNomina = !_abreGenerarNomina;
}