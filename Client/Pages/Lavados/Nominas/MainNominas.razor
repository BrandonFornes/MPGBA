        public DateTime Fecha { get; set; }
    }


    public bool _abreCrearLavado;

    public void AbrirCrearLavado()
    {
        if (_abreCrearLavado)
            _abreCrearLavado = false;
        else
            _abreCrearLavado = true;
    }


    bool success;
    string[] errors = { };
    MudForm form;

    string lavadorSeleccionado;
    string tareaSeleccionada;
    DateTime? fechaSeleccionada;

    void TryRegistrarLavado()
    {
        form.Validate();
        if (form.IsValid)
        {
            form.Reset();
            lavadorSeleccionado = null;
            tareaSeleccionada = null;
            fechaSeleccionada = null;
        }
    }

