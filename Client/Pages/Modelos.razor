@page "/modelos"
@using MudBlazor
@inject NavigationManager NavigationManager

<MudGrid Class="mt-5" Justify="Justify.Center">
<MudItem xs="10">

        <MudText Typo="Typo.h3" Class="mb-4">
            Modelos
        </MudText>

        <MudPaper Class="pa-4 mb-4">
            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       Color="Color.Tertiary"
                       Class="mr-3"
                       @onclick="NavegarARegistrarMarca">
                Agregar Marca
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       Color="Color.Info"
                       @onclick="NavegarARegistrarModelo">
                Agregar Modelo
            </MudButton>
        </MudPaper>

<MudDataGrid T="ModeloRow"
             Items="@ListaModelos"
             Filterable="true"
             Sortable="true"
             QuickFilter="@_quickFilter">

    <ToolBarContent>
        <MudText Typo="Typo.h6">Catálogo de Modelos</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_searchString"
                      Placeholder="Buscar marca o modelo..."
                      Adornment="Adornment.Start"
                      Immediate="true"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"
                      Class="mt-0" />
    </ToolBarContent>

    <Columns>
        <PropertyColumn Property="x => x.Id" Title="ID" />
        <PropertyColumn Property="x => x.NombreMarca" Title="Marca" />
        <PropertyColumn Property="x => x.NombreModelo" Title="Modelo" />
    </Columns>

    <PagerContent>
        <MudDataGridPager T="ModeloRow" />
    </PagerContent>

</MudDataGrid>

<MudCardActions>
    <MudButton Variant="Variant.Filled"
               Color="Color.Secondary"
               Class="ml-auto"
               DisableElevation="true">
        Eliminar Modelo
    </MudButton>
</MudCardActions>

</MudItem>
</MudGrid>

@code {

    private string _searchString;
    private List<ModeloRow> ListaModelos = new();

    protected override void OnInitialized()
    {
        ListaModelos.AddRange(new[]
        {
            new ModeloRow { Id = 1, NombreMarca = "Toyota", NombreModelo = "Corolla" },
            new ModeloRow { Id = 2, NombreMarca = "Ford", NombreModelo = "F-150" },
            new ModeloRow { Id = 3, NombreMarca = "Ford", NombreModelo = "Mustang" },
            new ModeloRow { Id = 4, NombreMarca = "Nissan", NombreModelo = "Sentra" },
            new ModeloRow { Id = 5, NombreMarca = "Mazda", NombreModelo = "CX-5" },
            new ModeloRow { Id = 6, NombreMarca = "Jeep", NombreModelo = "Wrangler" },
            new ModeloRow { Id = 7, NombreMarca = "Dodge", NombreModelo = "Challenger" },
            new ModeloRow { Id = 8, NombreMarca = "Automotriz del Noroeste", NombreModelo = "Generico" }
        });
    }

    private bool _quickFilter(ModeloRow x)
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.NombreMarca?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;

        if (x.NombreModelo?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;

        return false;
    }

    private void EliminarModelo(ModeloRow modelo)
    {
        ListaModelos.Remove(modelo);
    }

    private void NavegarARegistrarMarca()
    {
        NavigationManager.NavigateTo("/registro_marcas");
    }

    private void NavegarARegistrarModelo()
    {
        NavigationManager.NavigateTo("/registro_modelos");
    }

    public class ModeloRow
    {
        public int Id { get; set; }
        public string NombreMarca { get; set; }
        public string NombreModelo { get; set; }
    }
}
